---
---

<section id="contact" class="bg-bg-alt py-28 md:py-40">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-14">
      <div class="text-[12px] font-medium uppercase tracking-[0.18em] text-accent mb-5">
        Let's talk
      </div>
      <h2 class="font-display display-tight text-5xl md:text-7xl font-bold">
        Tell us about
        <br />
        <span class="gradient-text">your business.</span>
      </h2>
      <p class="mt-6 text-lg text-ink-soft max-w-xl mx-auto">
        A short note is enough. We reply within one working day with honest next steps — even if those steps are "you don't need us yet."
      </p>
    </div>

    <form
      action="https://formspree.io/f/your-form-id"
      method="POST"
      class="grid gap-5 bg-white rounded-3xl p-8 md:p-12 border border-line"
    >
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="text-[13px] font-medium text-ink">Your name</span>
          <input
            type="text"
            name="name"
            required
            class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          />
        </label>
        <label class="block">
          <span class="text-[13px] font-medium text-ink">Business name</span>
          <input
            type="text"
            name="business"
            class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          />
        </label>
      </div>
      <label class="block">
        <span class="text-[13px] font-medium text-ink">Email or phone</span>
        <input
          type="text"
          name="contact"
          required
          class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
        />
      </label>

      <fieldset class="block">
        <legend class="text-[13px] font-medium text-ink mb-3">What are you after?</legend>
        <div class="flex flex-wrap gap-2">
          {
            ["Website", "Social media", "Catalogue", "Not sure yet"].map((opt) => (
              <label class="inline-flex items-center gap-2 bg-white border border-line rounded-full px-4 py-2 text-sm cursor-pointer hover:border-accent has-checked:bg-accent has-checked:text-white has-checked:border-accent transition-colors">
                <input type="checkbox" name="interest" value={opt} class="sr-only" />
                {opt}
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="block">
        <span class="text-[13px] font-medium text-ink">Tell us a bit about your business</span>
        <textarea
          name="message"
          rows="4"
          class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
        ></textarea>
      </label>

      <button
        type="submit"
        class="justify-self-start inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white px-7 py-3 rounded-full text-[15px] font-medium transition-colors"
      >
        Send it through
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </button>

      <p class="text-xs text-ink-soft pt-2">
        Prefer email? <a href="mailto:hello@shopfrontstudio.com.au" class="text-accent hover:underline">hello@shopfrontstudio.com.au</a>
      </p>
    </form>
  </div>
</section>
