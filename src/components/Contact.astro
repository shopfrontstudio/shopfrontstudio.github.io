---
---

<section id="contact" class="bg-black text-silver-100 py-28 md:py-40 border-t border-line">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-14">
      <div class="text-[12px] font-medium uppercase tracking-[0.22em] text-silver-400 mb-5">
        Let's talk
      </div>
      <h2 class="font-display display-tight text-5xl md:text-7xl">
        <span class="text-white">Tell us about</span>
        <br />
        <span class="silver-text">your business.</span>
      </h2>
      <p class="mt-6 text-lg text-silver-300 max-w-xl mx-auto">
        A short note is enough. We reply within one working day with honest next steps — even if those steps are "you don't need us yet."
      </p>
    </div>

    <form
      action="https://formspree.io/f/your-form-id"
      method="POST"
      class="grid gap-5 bg-graphite border border-line rounded-3xl p-8 md:p-12"
    >
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="text-[13px] font-medium text-silver-200">Your name</span>
          <input
            type="text"
            name="name"
            required
            class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-silver-50 focus:border-silver-300 focus:outline-none focus:ring-2 focus:ring-silver-300/20"
          />
        </label>
        <label class="block">
          <span class="text-[13px] font-medium text-silver-200">Business name</span>
          <input
            type="text"
            name="business"
            class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-silver-50 focus:border-silver-300 focus:outline-none focus:ring-2 focus:ring-silver-300/20"
          />
        </label>
      </div>
      <label class="block">
        <span class="text-[13px] font-medium text-silver-200">Email or phone</span>
        <input
          type="text"
          name="contact"
          required
          class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-silver-50 focus:border-silver-300 focus:outline-none focus:ring-2 focus:ring-silver-300/20"
        />
      </label>

      <fieldset class="block">
        <legend class="text-[13px] font-medium text-silver-200 mb-3">What are you after?</legend>
        <div class="flex flex-wrap gap-2">
          {
            ["Website", "Social media", "Catalogue", "Not sure yet"].map((opt) => (
              <label class="inline-flex items-center gap-2 bg-graphite-soft border border-line rounded-full px-4 py-2 text-sm cursor-pointer text-silver-200 hover:border-silver-400 has-checked:bg-silver-100 has-checked:text-onyx has-checked:border-silver-100 transition-colors">
                <input type="checkbox" name="interest" value={opt} class="sr-only" />
                {opt}
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="block">
        <span class="text-[13px] font-medium text-silver-200">Tell us a bit about your business</span>
        <textarea
          name="message"
          rows="4"
          class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-silver-50 focus:border-silver-300 focus:outline-none focus:ring-2 focus:ring-silver-300/20"
        ></textarea>
      </label>

      <button
        type="submit"
        class="justify-self-start inline-flex items-center gap-2 bg-silver-100 hover:bg-white text-onyx px-7 py-3 rounded-full text-[14px] font-semibold transition-colors"
      >
        Send it through
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </button>

      <p class="text-xs text-silver-500 pt-2">
        Prefer email? <a href="mailto:hello@shopfrontstudio.com.au" class="text-silver-200 hover:text-white underline underline-offset-4">hello@shopfrontstudio.com.au</a>
      </p>
    </form>
  </div>
</section>
