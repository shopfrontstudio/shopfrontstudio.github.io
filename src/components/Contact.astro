---
---

<section id="contact" class="relative text-cream py-28 md:py-40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="hairline-gold max-w-3xl mb-16 md:mb-24 opacity-50"></div>
    <div class="grid md:grid-cols-12 gap-12 md:gap-16 items-start">
      {/* left — message */}
      <div class="md:col-span-5 md:pt-4" data-reveal>
        <div class="text-[12px] lg:text-[18px] font-medium uppercase tracking-[0.30em] text-gold mb-5">
          Begin
        </div>
        <h2 class="font-display display-tight text-5xl md:text-6xl lg:text-[4.8rem]">
          <span class="gradient-cream">Tell us what</span>
          <br />
          <span class="gradient-crimson italic">you're building.</span>
        </h2>
        <p class="mt-6 text-lg lg:text-[24px] text-cream-soft max-w-md leading-relaxed">
          A short note is enough. We reply within one working day with honest next
          steps — even if those steps are "you don't need us yet."
        </p>
        <div class="mt-10 space-y-3 text-[15px] lg:text-[18px]">
          <a href="mailto:info@anaramarketing.com.au" class="link-underline flex items-center gap-3 text-cream-soft hover:text-cream transition-colors">
            <span class="text-gold">✦</span> info@anaramarketing.com.au
          </a>
          <a href="tel:+61473533053" class="link-underline flex items-center gap-3 text-cream-soft hover:text-cream transition-colors">
            <span class="text-gold">✦</span> +61 473 533 053
          </a>
          <div class="flex items-center gap-3 text-cream-mute">
            <span class="text-gold">✦</span> Ballarat, Victoria
          </div>
        </div>
      </div>

      {/* right — form card */}
      <div class="md:col-span-7" data-reveal style="--reveal-delay: 120ms">
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="grid gap-5 bg-graphite border border-line rounded-3xl p-8 md:p-10 glow-hover"
    >
      {/* Web3Forms config */}
      <input type="hidden" name="access_key" value="c90c681f-8abc-4eb1-b07c-ab82aec3e435" />
      <input type="hidden" name="subject" value="New enquiry from anaramarketing.com.au" />
      <input type="hidden" name="from_name" value="Anara Marketing website" />
      {/* Honeypot — bots fill this, humans never see it */}
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="text-[13px] lg:text-[18px] font-medium text-cream-soft">Your name</span>
          <input
            type="text"
            name="name"
            required
            class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 lg:py-4 text-cream lg:text-[18px] focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/20"
          />
        </label>
        <label class="block">
          <span class="text-[13px] lg:text-[18px] font-medium text-cream-soft">Business name</span>
          <input
            type="text"
            name="business"
            class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 lg:py-4 text-cream lg:text-[18px] focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/20"
          />
        </label>
      </div>
      <label class="block">
        <span class="text-[13px] lg:text-[18px] font-medium text-cream-soft">Email or phone</span>
        <input
          type="text"
          name="contact"
          required
          class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-cream focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/20"
        />
      </label>

      <fieldset class="block">
        <legend class="text-[13px] lg:text-[18px] font-medium text-cream-soft mb-3">What are you after?</legend>
        <div class="flex flex-wrap gap-2">
          {
            ["Website", "Social", "Catalogue", "Not sure yet"].map((opt) => (
              <label class="inline-flex items-center gap-2 bg-graphite-soft border border-line rounded-full px-4 py-2 lg:px-5 lg:py-2.5 text-sm lg:text-[18px] cursor-pointer text-cream-soft hover:border-gold has-checked:bg-crimson-deep has-checked:text-cream has-checked:border-crimson-deep transition-colors">
                <input type="checkbox" name="interest" value={opt} class="sr-only" />
                {opt}
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="block">
        <span class="text-[13px] lg:text-[18px] font-medium text-cream-soft">A line about your business</span>
        <textarea
          name="message"
          rows="4"
          class="mt-2 w-full rounded-xl border border-line bg-graphite-soft px-4 py-3 text-cream focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/20"
        ></textarea>
      </label>

      <button
        type="submit"
        class="group btn-primary justify-self-start inline-flex items-center gap-2 bg-crimson-deep hover:bg-crimson text-cream px-7 py-3 lg:px-9 lg:py-4 rounded-full text-[14px] lg:text-[19px] font-semibold tracking-wide"
      >
        Send it through
        <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden text-[14px] lg:text-[17px]"></p>
    </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  if (form && status) {
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const defaultLabel = submitBtn?.innerHTML ?? "";

    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove("hidden");
      status.style.color = ok ? "var(--color-gold-bright)" : "#e7728a";
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = await res.json();

        if (res.ok) {
          show("Thanks — your note's on its way. We'll reply within one working day.", true);
          form.reset();
        } else {
          show(data?.message || "Something went wrong. Please email us directly at info@anaramarketing.com.au.", false);
        }
      } catch {
        show("Couldn't send just now. Please email us directly at info@anaramarketing.com.au.", false);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = defaultLabel;
        }
      }
    });
  }
</script>
