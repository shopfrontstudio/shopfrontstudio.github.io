---
---

<section id="contact" class="bg-paper-soft py-28 md:py-40 border-t border-line/40">
  <div class="max-w-3xl mx-auto px-6">
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-10 h-px bg-gold"></span>
        <span class="eyebrow">Begin</span>
      </div>
      <h2 class="font-display display-tight text-5xl md:text-7xl text-ink">
        Tell us about
        <br />
        <span class="italic-gold">your business.</span>
      </h2>
      <p class="mt-6 text-lg md:text-xl text-ink-soft max-w-xl">
        A short note is enough. We reply within one working day with honest next steps — even if those steps are "you don't need us yet."
      </p>
    </div>

    <form
      action="https://formspree.io/f/your-form-id"
      method="POST"
      class="grid gap-5 bg-paper rounded-2xl p-8 md:p-12 border border-line/60"
    >
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="eyebrow">Your name</span>
          <input
            type="text"
            name="name"
            required
            class="mt-3 w-full rounded-lg border border-line bg-paper-soft/40 px-4 py-3 text-ink focus:border-gold focus:bg-paper focus:outline-none focus:ring-2 focus:ring-gold/15"
          />
        </label>
        <label class="block">
          <span class="eyebrow">Business name</span>
          <input
            type="text"
            name="business"
            class="mt-3 w-full rounded-lg border border-line bg-paper-soft/40 px-4 py-3 text-ink focus:border-gold focus:bg-paper focus:outline-none focus:ring-2 focus:ring-gold/15"
          />
        </label>
      </div>
      <label class="block">
        <span class="eyebrow">Email or phone</span>
        <input
          type="text"
          name="contact"
          required
          class="mt-3 w-full rounded-lg border border-line bg-paper-soft/40 px-4 py-3 text-ink focus:border-gold focus:bg-paper focus:outline-none focus:ring-2 focus:ring-gold/15"
        />
      </label>

      <fieldset class="block">
        <legend class="eyebrow mb-4">What are you after</legend>
        <div class="flex flex-wrap gap-2">
          {
            ["Website", "Social", "Catalogue", "Not sure yet"].map((opt) => (
              <label class="inline-flex items-center gap-2 bg-paper-soft/50 border border-line rounded-full px-4 py-2 text-sm cursor-pointer hover:border-gold has-checked:bg-graphite has-checked:text-paper has-checked:border-graphite transition-colors">
                <input type="checkbox" name="interest" value={opt} class="sr-only" />
                {opt}
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="block">
        <span class="eyebrow">A line about your business</span>
        <textarea
          name="message"
          rows="4"
          class="mt-3 w-full rounded-lg border border-line bg-paper-soft/40 px-4 py-3 text-ink focus:border-gold focus:bg-paper focus:outline-none focus:ring-2 focus:ring-gold/15"
        ></textarea>
      </label>

      <button
        type="submit"
        class="justify-self-start inline-flex items-center gap-2 bg-graphite text-paper px-7 py-3.5 rounded-full text-[14px] font-medium tracking-wide hover:bg-gold-dark transition-colors"
      >
        Send it through
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </button>

      <p class="text-xs text-ink-mute pt-2 tracking-wide">
        Or by mail — <a href="mailto:hello@shopfrontstudio.com.au" class="text-gold-dark hover:underline">hello@shopfrontstudio.com.au</a>
      </p>
    </form>
  </div>
</section>
