---
const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 glass-dark border-b border-line-bright">
  <div class="relative max-w-6xl mx-auto px-6 h-14 lg:h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/anara-mark.png" alt="" class="w-9 h-9 lg:w-11 lg:h-11 block" aria-hidden="true" />
      <span class="font-display text-[17px] lg:text-[23px] font-medium tracking-[0.18em] text-cream">ANARA</span>
      <span class="hidden sm:inline text-gold text-[10px] lg:text-[16px] tracking-[0.32em] uppercase">Marketing Solutions</span>
    </a>

    <nav class="hidden md:flex items-center gap-9 text-[13px] lg:text-[18px] tracking-wide text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="link-underline hover:text-cream transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="btn-primary hidden md:inline-flex items-center bg-crimson-deep text-cream px-4 py-1.5 lg:px-5 lg:py-2 rounded-full text-[12.5px] lg:text-[17px] font-medium hover:bg-crimson tracking-wide"
      >Enquire</a
    >

    {/* Skeuomorphic pull-switch — drops from the header on load; pull to toggle theme */}
    <button
      id="theme-toggle"
      type="button"
      aria-label="Pull to switch between light and dark mode"
      title="Pull to switch theme"
      class="theme-switch"
    >
      <span class="theme-switch__hang" aria-hidden="true">
        <svg class="theme-switch__cord" width="16" height="58" viewBox="0 0 16 58" fill="none">
          <line x1="8" y1="0" x2="8" y2="7" stroke="var(--switch-cord)" stroke-width="2" stroke-linecap="round" />
          <ellipse cx="8" cy="11" rx="5" ry="3.1" stroke="var(--switch-cord)" stroke-width="2" />
          <ellipse cx="8" cy="18" rx="5" ry="3.1" stroke="var(--switch-cord)" stroke-width="2" />
          <ellipse cx="8" cy="25" rx="5" ry="3.1" stroke="var(--switch-cord)" stroke-width="2" />
          <ellipse cx="8" cy="32" rx="5" ry="3.1" stroke="var(--switch-cord)" stroke-width="2" />
          <ellipse cx="8" cy="39" rx="5" ry="3.1" stroke="var(--switch-cord)" stroke-width="2" />
          <line x1="8" y1="42" x2="8" y2="49" stroke="var(--switch-cord)" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="theme-switch__knob"></span>
      </span>
    </button>

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream"
      aria-label="Toggle menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line-bright glass-dark">
    <nav class="px-6 py-5 flex flex-col gap-4 text-sm text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-cream" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="bg-crimson-deep text-cream px-4 py-2 rounded-full text-center font-medium"
        data-mobile-link>Enquire</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
