---
const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 glass-dark border-b border-line-bright">
  <div class="relative max-w-6xl mx-auto px-6 h-14 lg:h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/anara-mark.png" alt="" class="w-9 h-9 lg:w-11 lg:h-11 block" aria-hidden="true" />
      <span class="font-display text-[17px] lg:text-[23px] font-medium tracking-[0.18em] text-cream">ANARA</span>
      <span class="hidden sm:inline text-gold text-[10px] lg:text-[16px] tracking-[0.32em] uppercase">Marketing Solutions</span>
    </a>

    <nav class="hidden md:flex items-center gap-9 text-[13px] lg:text-[18px] tracking-wide text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="link-underline hover:text-cream transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="btn-primary hidden md:inline-flex items-center bg-crimson-deep text-cream px-4 py-1.5 lg:px-5 lg:py-2 rounded-full text-[12.5px] lg:text-[17px] font-medium hover:bg-crimson tracking-wide"
      >Enquire</a
    >

    {/* Hanging pendant lamp — drops from the header on load; the placard flips
        LIGHT/DARK and the bulb glows warm-white (dark) / pomegranate (light). */}
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle between light and dark mode"
      title="Switch theme"
      class="lamp"
    >
      <span class="lamp__hang">
        <svg class="lamp__art" width="130" height="270" viewBox="0 0 130 270" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="lampBrass" x1="0" y1="0" x2="1" y2="0.4">
              <stop offset="0" stop-color="#f0d79b" /><stop offset="0.35" stop-color="#b88f47" />
              <stop offset="0.6" stop-color="#8a6a30" /><stop offset="1" stop-color="#d8b16a" />
            </linearGradient>
            <linearGradient id="lampShade" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#15151b" /><stop offset="0.32" stop-color="#4b4b57" />
              <stop offset="0.5" stop-color="#33333d" /><stop offset="0.72" stop-color="#191920" />
              <stop offset="1" stop-color="#0c0c10" />
            </linearGradient>
            <linearGradient id="lampShadeTop" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#5a5a66" /><stop offset="1" stop-color="#5a5a66" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="lampGlass" cx="50%" cy="42%" r="60%">
              <stop class="lamp-glass-a" offset="0" /><stop class="lamp-glass-b" offset="0.55" /><stop class="lamp-glass-c" offset="1" />
            </radialGradient>
            <radialGradient id="lampGlow" cx="50%" cy="50%" r="50%">
              <stop class="lamp-glow-a" offset="0" /><stop class="lamp-glow-b" offset="0.45" /><stop class="lamp-glow-c" offset="1" />
            </radialGradient>
            <filter id="lampSoft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1.1" /></filter>
          </defs>

          <circle class="lamp__glow" cx="65" cy="205" r="54" fill="url(#lampGlow)" />

          {/* gold chain */}
          <g stroke="url(#lampBrass)" stroke-width="3.4" fill="none" filter="url(#lampSoft)">
            <ellipse cx="65" cy="9" rx="4.2" ry="8" /><ellipse cx="65" cy="20" rx="8" ry="4.2" />
            <ellipse cx="65" cy="31" rx="4.2" ry="8" /><ellipse cx="65" cy="42" rx="8" ry="4.2" />
            <ellipse cx="65" cy="53" rx="4.2" ry="8" /><ellipse cx="65" cy="64" rx="8" ry="4.2" />
            <ellipse cx="65" cy="75" rx="4.2" ry="8" /><ellipse cx="65" cy="86" rx="8" ry="4.2" />
          </g>

          {/* placard */}
          <g transform="rotate(-8 26 30)">
            <line x1="57" y1="20" x2="40" y2="30" stroke="url(#lampBrass)" stroke-width="1.6" />
            <rect x="5" y="28" width="44" height="20" rx="4" fill="#241619" stroke="url(#lampBrass)" stroke-width="1.4" />
            <text class="lamp-txt lamp-txt-light" x="27" y="42" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="12.5" font-weight="700" letter-spacing="0.6" fill="#ecdcb2">LIGHT</text>
            <text class="lamp-txt lamp-txt-dark" x="27" y="42" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="12.5" font-weight="700" letter-spacing="0.6" fill="#ecdcb2">DARK</text>
          </g>

          {/* canopy / socket */}
          <path d="M56 90 L74 90 L70 102 L60 102 Z" fill="url(#lampBrass)" />
          <rect x="58" y="100" width="14" height="6" rx="2" fill="#7a5f2b" />

          {/* shade */}
          <path d="M52 106 L78 106 L112 168 Q65 186 18 168 Z" fill="url(#lampShade)" stroke="#0a0a0e" stroke-width="1" />
          <path d="M52 106 L78 106 L98 150 Q65 158 32 150 Z" fill="url(#lampShadeTop)" opacity="0.5" />
          <ellipse cx="65" cy="169" rx="47" ry="10" fill="#0c0c10" />
          <path d="M20 168 Q65 185 110 168" fill="none" stroke="#7d7d88" stroke-width="1.6" opacity="0.8" />

          {/* edison screw base */}
          <rect x="56" y="160" width="18" height="16" rx="2" fill="url(#lampBrass)" />
          <line x1="56" y1="164" x2="74" y2="165" stroke="#6e5526" stroke-width="1.2" />
          <line x1="56" y1="168" x2="74" y2="169" stroke="#6e5526" stroke-width="1.2" />
          <line x1="56" y1="172" x2="74" y2="173" stroke="#6e5526" stroke-width="1.2" />

          {/* bulb */}
          <path class="lamp__glass" d="M58 176 Q49 184 49 200 a16 16 0 1 0 32 0 Q81 184 72 176 Z" fill="url(#lampGlass)" stroke-opacity="0.5" stroke-width="0.8" />
          <g class="lamp__filament" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.95">
            <line x1="60" y1="178" x2="60" y2="192" /><line x1="70" y1="178" x2="70" y2="192" />
            <path d="M60 192 q5 9 10 0" />
          </g>
          <ellipse cx="59" cy="196" rx="5" ry="7" fill="#ffffff" opacity="0.18" />
        </svg>
      </span>
    </button>

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream"
      aria-label="Toggle menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line-bright glass-dark">
    <nav class="px-6 py-5 flex flex-col gap-4 text-sm text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-cream" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="bg-crimson-deep text-cream px-4 py-2 rounded-full text-center font-medium"
        data-mobile-link>Enquire</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
