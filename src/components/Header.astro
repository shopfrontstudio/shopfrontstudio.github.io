---
const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 glass-dark border-b border-line-bright">
  <div class="max-w-6xl mx-auto px-6 h-12 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <span
        class="w-7 h-7 rounded-md bg-graphite-soft border border-line-bright text-platinum-bright font-display font-extrabold flex items-center justify-center text-sm silver-text"
        >S</span
      >
      <span class="font-display text-[15px] font-semibold tracking-tight text-silver-100">Shopfront Studio</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-[13px] font-normal text-silver-300">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-silver-50 transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="hidden md:inline-flex bg-silver-100 text-onyx px-4 py-1.5 rounded-full text-[13px] font-semibold hover:bg-white transition-colors"
      >Enquire</a
    >

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-silver-100"
      aria-label="Toggle menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line-bright glass-dark">
    <nav class="px-6 py-5 flex flex-col gap-4 text-sm text-silver-200">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-white" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="bg-silver-100 text-onyx px-4 py-2 rounded-full text-center font-semibold"
        data-mobile-link>Enquire</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
