---
const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 glass-dark border-b border-line-bright">
  <div class="relative max-w-6xl mx-auto px-6 h-14 lg:h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/anara-mark.png" alt="" class="w-9 h-9 lg:w-11 lg:h-11 block" aria-hidden="true" />
      <span class="font-display text-[17px] lg:text-[23px] font-medium tracking-[0.18em] text-cream">ANARA</span>
      <span class="hidden sm:inline text-gold text-[10px] lg:text-[16px] tracking-[0.32em] uppercase">Marketing Solutions</span>
    </a>

    <nav class="hidden md:flex items-center gap-9 text-[13px] lg:text-[18px] tracking-wide text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="link-underline hover:text-cream transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="btn-primary hidden md:inline-flex items-center bg-crimson-deep text-cream px-4 py-1.5 lg:px-5 lg:py-2 rounded-full text-[12.5px] lg:text-[17px] font-medium hover:bg-crimson tracking-wide"
      >Enquire</a
    >

    {/* Hanging pendant lamp — drops from the header on a plain black cord; the
        lit underside glows warm-white (dark) / pomegranate (light) and casts a
        soft pool of light below. Click jolts it into a natural pendulum swing
        and flips the theme. */}
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle between light and dark mode"
      title="Switch theme"
      class="lamp"
    >
      <span class="lamp__hang">
        <svg class="lamp__art" width="170" height="320" viewBox="0 0 170 320" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="lampWood" x1="0" y1="0" x2="1" y2="0.6">
              <stop offset="0" stop-color="#9a6a3c" /><stop offset="0.5" stop-color="#6e4824" />
              <stop offset="1" stop-color="#3f2813" />
            </linearGradient>
            {/* matte metal dome — light catches the upper-left, falls off right */}
            <linearGradient id="lampShade" x1="0.08" y1="0.1" x2="0.92" y2="0.9">
              <stop offset="0" stop-color="#3c3c44" /><stop offset="0.32" stop-color="#28282e" />
              <stop offset="0.62" stop-color="#1a1a1e" /><stop offset="1" stop-color="#0d0d10" />
            </linearGradient>
            <radialGradient id="lampShadeHi" cx="34%" cy="26%" r="46%">
              <stop offset="0" stop-color="#6a6a76" stop-opacity="0.55" />
              <stop offset="1" stop-color="#6a6a76" stop-opacity="0" />
            </radialGradient>
            {/* lit underside / mouth of the shade */}
            <radialGradient id="lampMouth" cx="50%" cy="44%" r="62%">
              <stop class="lamp-mouth-a" offset="0" /><stop class="lamp-mouth-b" offset="0.5" />
              <stop class="lamp-mouth-c" offset="1" />
            </radialGradient>
            {/* warm beam falling from the mouth */}
            <linearGradient id="lampCone" x1="0" y1="0" x2="0" y2="1">
              <stop class="lamp-cone-a" offset="0" /><stop class="lamp-cone-b" offset="1" />
            </linearGradient>
            {/* pool of light cast below */}
            <radialGradient id="lampPool" cx="50%" cy="50%" r="50%">
              <stop class="lamp-pool-a" offset="0" /><stop class="lamp-pool-b" offset="1" />
            </radialGradient>
            <filter id="lampBlur" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="6" /></filter>
          </defs>

          {/* light cast below the lamp (soft, themeable) */}
          <g class="lamp__glow">
            <ellipse cx="85" cy="300" rx="78" ry="20" fill="url(#lampPool)" filter="url(#lampBlur)" />
            <path d="M40 187 L130 187 L158 304 L12 304 Z" fill="url(#lampCone)" filter="url(#lampBlur)" opacity="0.9" />
          </g>

          {/* plain black cord */}
          <line x1="85" y1="0" x2="85" y2="128" stroke="#161616" stroke-width="2.4" />

          {/* small LIGHT/DARK tag on a thin thread */}
          <g>
            <line x1="85" y1="46" x2="108" y2="58" stroke="#161616" stroke-width="1.2" />
            <rect x="100" y="56" width="44" height="19" rx="3.5" fill="#241619" stroke="#7a5f2b" stroke-width="1.1" />
            <text class="lamp-txt lamp-txt-light" x="122" y="69.5" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="0.5" fill="#ecdcb2">LIGHT</text>
            <text class="lamp-txt lamp-txt-dark" x="122" y="69.5" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="0.5" fill="#ecdcb2">DARK</text>
          </g>

          {/* wooden top fitting + neck */}
          <path d="M78 128 L92 128 L90 145 L80 145 Z" fill="url(#lampWood)" />
          <ellipse cx="85" cy="148" rx="14" ry="4" fill="#1c1c20" />

          {/* dome shade — shallow, wide bowl (~quarter circle) */}
          <path d="M28 184 C28 166 50 147 85 147 C120 147 142 166 142 184 Q85 200 28 184 Z" fill="url(#lampShade)" stroke="#0a0a0d" stroke-width="1" />
          <path d="M28 184 C28 166 50 147 85 147 C120 147 142 166 142 184 Q85 200 28 184 Z" fill="url(#lampShadeHi)" />
          {/* subtle groove near the crown */}
          <path d="M58 155 Q85 149 112 155" fill="none" stroke="#000" stroke-width="1" opacity="0.35" />

          {/* lit mouth (no visible bulb) */}
          <ellipse cx="85" cy="186" rx="52" ry="11" fill="url(#lampMouth)" />
          <path class="lamp__rim" d="M34 184 Q85 203 136 184" fill="none" stroke-width="2.4" opacity="0.85" stroke-linecap="round" />
        </svg>
      </span>
    </button>

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream"
      aria-label="Toggle menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line-bright glass-dark">
    <nav class="px-6 py-5 flex flex-col gap-4 text-sm text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-cream" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="bg-crimson-deep text-cream px-4 py-2 rounded-full text-center font-medium"
        data-mobile-link>Enquire</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
