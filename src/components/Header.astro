---
const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 glass-dark border-b border-line-bright">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/anara-mark.svg" alt="" class="w-9 h-9 block" aria-hidden="true" />
      <span class="font-display text-[17px] font-medium tracking-[0.18em] text-cream">ANARA</span>
      <span class="hidden sm:inline text-gold text-[10px] tracking-[0.32em] uppercase">Marketing Solutions</span>
    </a>

    <nav class="hidden md:flex items-center gap-9 text-[13px] tracking-wide text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-cream transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="hidden md:inline-flex items-center bg-crimson-deep text-cream px-4 py-1.5 rounded-full text-[12.5px] font-medium hover:bg-crimson transition-colors tracking-wide"
      >Enquire</a
    >

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream"
      aria-label="Toggle menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line-bright glass-dark">
    <nav class="px-6 py-5 flex flex-col gap-4 text-sm text-cream-soft">
      {
        nav.map((item) => (
          <a href={item.href} class="hover:text-cream" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="bg-crimson-deep text-cream px-4 py-2 rounded-full text-center font-medium"
        data-mobile-link>Enquire</a
      >
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
