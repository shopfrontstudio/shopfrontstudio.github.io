---
import AnimatedMark from "./AnimatedMark.astro";

const proof = [
  { value: "2-3", label: "week website launches" },
  { value: "1.8s", label: "target page-load feel" },
  { value: "Fixed", label: "written pricing first" },
  { value: "AU", label: "Victoria-based, Australia-wide" },
];
---

<section class="hero-cinema relative overflow-hidden text-cream" data-hero>
  <div class="hero-glow"></div>
  <span class="seed" style="left:8%;top:18%;width:10px;height:10px;--sd:15s"></span>
  <span class="seed" style="left:88%;top:24%;width:7px;height:7px;--sd:19s"></span>
  <span class="seed" style="left:15%;top:64%;width:6px;height:6px;--sd:17s"></span>
  <span class="seed" style="left:80%;top:72%;width:9px;height:9px;--sd:22s"></span>
  <span class="seed" style="left:50%;top:10%;width:5px;height:5px;--sd:24s"></span>

  <div class="hero-brand">
    <div class="hero-brand-mark hero-rise" aria-hidden="true"><AnimatedMark /></div>
    <div class="hero-brand-words hero-rise" style="--rise-delay: 120ms">
      <div class="font-display hero-wordmark text-cream font-medium">ANARA</div>
      <div class="hero-submark text-gold uppercase">Marketing Solutions</div>
    </div>
    <span class="scroll-cue hero-rise" style="--rise-delay: 300ms" aria-hidden="true"></span>
  </div>

  <div class="hero-shell relative max-w-6xl mx-auto px-6 pt-10 pb-20 md:pt-16 md:pb-28 lg:grid lg:grid-cols-12 lg:gap-12 lg:items-center">
    <div class="lg:col-span-6 xl:col-span-5">
      <div class="hero-kicker hero-rise" style="--rise-delay: 130ms">
        <span></span>
        Boutique digital presence for small business
      </div>

      <h1 class="hero-title font-display display-tight word-reveal mt-5">
        <span class="w gradient-cream" style="--wd: 210ms">Your shopfront,</span>
        <br />
        <span class="w gradient-crimson italic" style="--wd: 360ms">considered</span>
        <br />
        <span class="w gradient-crimson italic" style="--wd: 500ms">online.</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg md:text-xl lg:text-[22px] text-cream-soft leading-relaxed hero-rise" style="--rise-delay: 300ms">
        Premium websites, social and Google-connected presence for Australian
        businesses ready to look established online.
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3 hero-rise" style="--rise-delay: 370ms">
        <a
          href="#contact"
          data-magnetic
          class="group btn-primary inline-flex items-center justify-center gap-2 bg-crimson-deep hover:bg-crimson text-cream px-7 py-3.5 lg:px-8 lg:py-4 rounded-full text-[14px] lg:text-[18px] font-semibold tracking-wide"
        >
          Get a free quote
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#estimate"
          class="btn-ghost inline-flex items-center justify-center px-7 py-3.5 lg:px-8 lg:py-4 rounded-full text-[14px] lg:text-[18px] font-medium text-cream border border-line-bright hover:border-gold/60 tracking-wide"
        >
          Shape a project
        </a>
      </div>

      <div class="hero-trust mt-8 hero-rise" style="--rise-delay: 460ms">
        <span>Written quotes</span>
        <span>No annual lock-ins</span>
        <span>Reply within 1 working day</span>
      </div>
    </div>

    <div class="hero-stage-wrap lg:col-span-6 xl:col-span-7 mt-14 lg:mt-0 hero-rise" style="--rise-delay: 430ms">
      <div class="hero-stage" data-hero-stage aria-hidden="true">
        <div class="hero-browser">
          <div class="hb-win hero-shopfront">
            <div class="hb-bar"><i></i><i></i><i></i><span class="hb-url"></span></div>
            <div class="hero-site">
              <div class="hero-site-nav">
                <span>ANARA</span>
                <i></i><i></i><i></i>
              </div>
              <div class="hero-site-main">
                <div>
                  <b>Your shopfront,</b>
                  <em>considered online.</em>
                  <u></u>
                </div>
                <span class="hero-site-photo"></span>
              </div>
              <div class="hero-site-grid"><span></span><span></span><span></span></div>
            </div>
          </div>
        </div>

        <div class="hero-phone">
          <div class="hero-phone-screen">
            <span class="hero-phone-top"></span>
            <div class="hero-post"></div>
            <div class="hero-hearts"><i></i><i></i><i></i></div>
            <b>1,329</b>
            <u></u><u></u>
          </div>
        </div>

        <div class="hero-search">
          <div class="hero-search-bar"></div>
          <div class="hero-search-row">
            <span></span>
            <div>
              <b>Anara Marketing</b>
              <em>★★★★★ 4.9</em>
              <p>Marketing studio · Victoria AU</p>
            </div>
          </div>
          <div class="hero-map"><i></i><u></u></div>
        </div>

        <div class="hero-note">
          <span>Launch plan</span>
          <b>Website + Google + content</b>
        </div>
      </div>
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 pb-16 md:pb-22">
    <div class="hero-proof-grid" id="hero-stats" data-reveal>
      {proof.map((item, i) => (
        <div class="hero-proof">
          <span>0{i + 1}</span>
          <b>{item.value}</b>
          <p>{item.label}</p>
        </div>
      ))}
    </div>

    <div class="flex justify-center mt-12 hero-rise" style="--rise-delay: 650ms">
      <span class="scroll-cue" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var stage = document.querySelector("[data-hero-stage]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!stage || reduce) return;

    var ticking = false;
    function update() {
      var h = window.innerHeight || 1;
      var rect = stage.getBoundingClientRect();
      var p = Math.min(Math.max((h - rect.top) / (h + rect.height), 0), 1);
      stage.style.setProperty("--hero-p", p.toFixed(3));
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>
