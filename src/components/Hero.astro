---
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-stone/40 to-cream"></div>
  <div class="max-w-6xl mx-auto px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-rust mb-6">
        <span class="w-8 h-px bg-rust"></span>
        Made in Ballarat
      </div>
      <h1 class="font-display text-5xl md:text-7xl font-semibold leading-[1.05] tracking-tight text-ink">
        Your shopfront,
        <span class="text-rust italic">online.</span>
      </h1>
      <p class="mt-8 text-lg md:text-xl text-ink/75 leading-relaxed max-w-2xl">
        A small studio in Ballarat helping local businesses get found, look good, and stay
        in front of customers. Websites that work on a phone. Social media that doesn't feel
        like a chore. Catalogues that actually sell things.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-ink text-cream px-6 py-3 rounded-md font-medium hover:bg-rust transition-colors"
        >
          Start a conversation
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#services"
          class="inline-flex items-center px-6 py-3 rounded-md font-medium text-ink border border-ink/20 hover:border-ink transition-colors"
        >
          See what we do
        </a>
      </div>

      <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-ink/60">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
          Cafés & hospitality
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
          Boutiques & makers
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
          Tradies & services
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
          Wineries & cellar doors
        </div>
      </div>
    </div>
  </div>
</section>
