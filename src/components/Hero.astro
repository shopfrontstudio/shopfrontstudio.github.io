---
---

<section class="relative bg-paper overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none opacity-50"
    style="background:
      radial-gradient(60% 45% at 80% 0%, rgba(168,133,74,0.18) 0%, rgba(243,237,226,0) 60%),
      radial-gradient(50% 50% at 0% 100%, rgba(230,205,184,0.4) 0%, rgba(243,237,226,0) 60%);"
  ></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-28 pb-28 md:pt-44 md:pb-40">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 mb-10">
        <span class="w-10 h-px bg-gold"></span>
        <span class="eyebrow">Est. Ballarat · Victoria</span>
      </div>

      <h1 class="font-display display-tight text-[58px] sm:text-7xl md:text-8xl lg:text-[120px] text-ink">
        Your shopfront,
        <br />
        <span class="italic-gold">considered online.</span>
      </h1>

      <p class="mt-10 max-w-2xl text-xl md:text-2xl text-ink-soft leading-[1.5] font-normal">
        A small studio for the local trades that already know what they're doing — and just
        need their corner of the internet to feel the same. Websites, social, and catalogues,
        made with care.
      </p>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-graphite text-paper px-7 py-3.5 rounded-full text-[14px] font-medium tracking-wide hover:bg-gold-dark transition-colors"
        >
          Begin a project
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#services"
          class="inline-flex items-center px-7 py-3.5 rounded-full text-[14px] font-medium tracking-wide text-ink border border-line hover:border-gold transition-colors"
        >
          What we do
        </a>
      </div>
    </div>

    <div class="hairline mt-24 max-w-3xl"></div>

    <dl class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6 max-w-3xl">
      <div>
        <dt class="eyebrow">Site launch</dt>
        <dd class="font-display text-3xl md:text-4xl mt-2 text-ink">
          Two to three <span class="italic-gold">weeks</span>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Page weight</dt>
        <dd class="font-display text-3xl md:text-4xl mt-2 text-ink">
          Under two <span class="italic-gold">seconds</span>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Pricing</dt>
        <dd class="font-display text-3xl md:text-4xl mt-2 text-ink">
          Fixed, <span class="italic-gold">in writing</span>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Contracts</dt>
        <dd class="font-display text-3xl md:text-4xl mt-2 text-ink">
          No annual <span class="italic-gold">lock-in</span>
        </dd>
      </div>
    </dl>
  </div>
</section>
