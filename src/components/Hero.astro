---
---

<section class="relative overflow-hidden text-silver-100">
  <div class="hero-glow"></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-28 pb-32 md:pt-40 md:pb-44 text-center">
    <div class="inline-flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.22em] text-silver-400 mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-platinum animate-pulse"></span>
      Made in Ballarat
    </div>

    <h1 class="font-display display-tight text-[56px] sm:text-7xl md:text-8xl lg:text-[128px]">
      <span class="text-white">Your shopfront.</span>
      <br />
      <span class="silver-text">Reimagined online.</span>
    </h1>

    <p class="mt-10 mx-auto max-w-2xl text-lg md:text-xl text-silver-300 leading-relaxed font-normal">
      A small studio in Ballarat. We build websites that load before the page above them.
      Run social media that actually fills tables. Design catalogues people keep.
    </p>

    <div class="mt-12 flex flex-wrap gap-3 justify-center">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 bg-silver-100 hover:bg-white text-onyx px-7 py-3 rounded-full text-[14px] font-semibold transition-colors"
      >
        Start a project
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#services"
        class="inline-flex items-center px-7 py-3 rounded-full text-[14px] font-medium text-silver-100 border border-line-bright hover:border-silver-300 transition-colors"
      >
        See what we do
      </a>
    </div>

    <div class="hairline-silver mt-24 max-w-3xl mx-auto"></div>

    <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl mx-auto text-left">
      <div>
        <div class="font-display text-3xl md:text-4xl font-bold silver-text">2–3<span class="text-silver-500 font-normal">wk</span></div>
        <div class="mt-1 text-xs uppercase tracking-[0.2em] text-silver-500">Site launch</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl font-bold silver-text">&lt;2<span class="text-silver-500 font-normal">s</span></div>
        <div class="mt-1 text-xs uppercase tracking-[0.2em] text-silver-500">Page load</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl font-bold silver-text">100<span class="text-silver-500 font-normal">%</span></div>
        <div class="mt-1 text-xs uppercase tracking-[0.2em] text-silver-500">Mobile first</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl font-bold silver-text">0<span class="text-silver-500 font-normal">bs</span></div>
        <div class="mt-1 text-xs uppercase tracking-[0.2em] text-silver-500">Lock-in</div>
      </div>
    </div>
  </div>
</section>
