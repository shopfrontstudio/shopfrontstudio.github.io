---
import AnimatedMark from "./AnimatedMark.astro";
---

<section class="relative overflow-hidden text-cream">
  <div class="hero-glow"></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-32 md:pt-28 md:pb-44 text-center">
    <!-- Animated pomegranate — dots rest in fruit form, then disperse,
         cluster around a one-word service punch, and reform. -->
    <div class="mb-2">
      <AnimatedMark />
    </div>

    <!-- Wordmark — rebuilt in code so it lives on any background -->
    <div class="flex flex-col items-center mb-12">
      <div class="font-display text-6xl md:text-8xl tracking-[0.22em] text-cream font-medium">
        ANARA
      </div>
      <div class="flex items-center gap-4 mt-3">
        <span class="h-px w-10 bg-gold/70"></span>
        <span class="text-[10px] md:text-[11px] font-medium tracking-[0.40em] uppercase text-gold">
          Marketing Solutions
        </span>
        <span class="h-px w-10 bg-gold/70"></span>
      </div>
    </div>

    <div class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.32em] text-cream-mute mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-crimson animate-pulse"></span>
      Made in Ballarat
    </div>

    <h1 class="font-display display-tight text-[48px] sm:text-6xl md:text-7xl lg:text-8xl">
      <span class="gradient-cream">Your shopfront,</span>
      <br />
      <span class="gradient-crimson italic">considered online.</span>
    </h1>

    <p class="mt-10 mx-auto max-w-2xl text-lg md:text-xl text-cream-soft leading-relaxed font-normal">
      A small studio in Ballarat. Websites built with care. Social that
      brings people through the door. Print and digital catalogues that
      keep working long after they leave your hand.
    </p>

    <div class="mt-12 flex flex-wrap gap-3 justify-center">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 bg-crimson-deep hover:bg-crimson text-cream px-7 py-3 rounded-full text-[14px] font-semibold transition-colors tracking-wide"
      >
        Begin a project
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#services"
        class="inline-flex items-center px-7 py-3 rounded-full text-[14px] font-medium text-cream border border-line-bright hover:border-gold/60 transition-colors tracking-wide"
      >
        What we do
      </a>
    </div>

    <div class="hairline-gold mt-24 max-w-3xl mx-auto"></div>

    <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl mx-auto text-left">
      <div>
        <div class="font-display text-3xl md:text-4xl gradient-cream">Two to three<span class="italic-gold"> weeks</span></div>
        <div class="mt-2 text-[10.5px] uppercase tracking-[0.28em] text-cream-mute">Site launch</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl gradient-cream">Under two<span class="italic-gold"> seconds</span></div>
        <div class="mt-2 text-[10.5px] uppercase tracking-[0.28em] text-cream-mute">Page weight</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl gradient-cream">Fixed,<span class="italic-gold"> in writing</span></div>
        <div class="mt-2 text-[10.5px] uppercase tracking-[0.28em] text-cream-mute">Pricing</div>
      </div>
      <div>
        <div class="font-display text-3xl md:text-4xl gradient-cream">No annual<span class="italic-gold"> lock-in</span></div>
        <div class="mt-2 text-[10.5px] uppercase tracking-[0.28em] text-cream-mute">Contracts</div>
      </div>
    </div>
  </div>
</section>
