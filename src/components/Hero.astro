---
import AnimatedMark from "./AnimatedMark.astro";
---

<section class="relative overflow-hidden text-cream" data-hero>
  <div class="hero-glow"></div>
  <span class="seed" style="left:6%;top:16%;width:10px;height:10px;--sd:15s"></span>
  <span class="seed" style="left:46%;top:10%;width:6px;height:6px;--sd:24s"></span>
  <span class="seed" style="left:54%;top:66%;width:7px;height:7px;--sd:19s"></span>
  <span class="seed" style="left:90%;top:30%;width:8px;height:8px;--sd:21s"></span>

  <div class="relative max-w-6xl mx-auto px-6 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-12 items-center lg:min-h-[88vh] pt-6 md:pt-10 lg:pt-0 pb-12">
      {/* LEFT — brand + headline */}
      <div class="text-center lg:text-left">
        <div class="mx-auto lg:mx-0 max-w-[260px] md:max-w-[300px] lg:max-w-[260px] mb-1 hero-rise">
          <AnimatedMark />
        </div>

        <div class="flex flex-col items-center lg:items-start mb-8 hero-rise" style="--rise-delay: 90ms">
          <div class="font-display text-4xl md:text-6xl lg:text-6xl tracking-[0.22em] text-cream font-medium">ANARA</div>
          <div class="flex items-center gap-4 mt-3">
            <span class="h-px w-10 bg-gold/70"></span>
            <span class="text-[10px] md:text-[11px] lg:text-[15px] font-medium tracking-[0.40em] uppercase text-gold">Marketing Solutions</span>
            <span class="h-px w-10 bg-gold/70 lg:hidden"></span>
          </div>
        </div>

        <h1 class="font-display display-tight text-[44px] sm:text-6xl md:text-7xl lg:text-[5.2rem] word-reveal">
          <span class="w gradient-cream" style="--wd: 240ms">Your</span>
          <span class="w gradient-cream" style="--wd: 330ms">shopfront,</span>
          <br />
          <span class="w gradient-crimson italic" style="--wd: 450ms">considered</span>
          <span class="w gradient-crimson italic" style="--wd: 560ms">online.</span>
        </h1>

        <p class="mt-7 mx-auto lg:mx-0 max-w-xl text-lg md:text-xl lg:text-[22px] text-cream-soft leading-relaxed hero-rise" style="--rise-delay: 320ms">
          A small studio in Ballarat. Websites, social and catalogues — built with
          care, wired to Google, and quietly cinematic.
        </p>

        <div class="mt-9 flex flex-wrap gap-3 justify-center lg:justify-start hero-rise" style="--rise-delay: 400ms">
          <a href="#contact" data-magnetic class="group btn-primary inline-flex items-center gap-2 bg-crimson-deep hover:bg-crimson text-cream px-7 py-3 lg:px-9 lg:py-4 rounded-full text-[14px] lg:text-[19px] font-semibold tracking-wide">
            Get a free quote
            <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
          </a>
          <a href="#services" class="btn-ghost inline-flex items-center px-7 py-3 lg:px-9 lg:py-4 rounded-full text-[14px] lg:text-[19px] font-medium text-cream border border-line-bright hover:border-gold/60 tracking-wide">
            View services
          </a>
        </div>

        <div class="ticker mt-10 max-w-xl mx-auto lg:mx-0 hero-rise" style="--rise-delay: 480ms">
          <div class="ticker__row text-[12px] lg:text-[14px] font-medium uppercase tracking-[0.2em]">
            <span><b>Websites</b><i>·</i><b>Social</b><i>·</i><b>Catalogues</b><i>·</i><b>Google-connected</b><i>·</i><b>Fixed-price</b><i>·</i><b>Ballarat-born</b><i>·</i></span>
            <span aria-hidden="true"><b>Websites</b><i>·</i><b>Social</b><i>·</i><b>Catalogues</b><i>·</i><b>Google-connected</b><i>·</i><b>Fixed-price</b><i>·</i><b>Ballarat-born</b><i>·</i></span>
          </div>
        </div>
      </div>

      {/* RIGHT — floating live browser preview */}
      <div class="hidden lg:block hero-rise" style="--rise-delay: 360ms">
        <div class="hero-browser" data-tilt aria-hidden="true">
          <div class="dev-inner">
            <div class="hb-win">
              <div class="hb-bar"><i></i><i></i><i></i><span class="hb-url"></span></div>
              <div class="lap-vp">
                <div class="lap-page">
                  <div class="lp-nav"><span class="lp-logo">ANARA</span><span class="lp-menu"><i></i><i></i><i></i></span></div>
                  <div class="lp-hero"><div class="lp-h1">Your shopfront,</div><div class="lp-h2">considered online.</div><span class="lp-btn"></span></div>
                  <div class="lp-cards"><div></div><div></div><div></div></div>
                  <div class="lp-feat"><span class="lp-fimg"></span><span class="lp-flines"><i></i><i></i><i></i></span></div>
                  <div class="lp-cards"><div></div><div></div><div></div></div>
                  <div class="lp-foot"></div>
                </div>
              </div>
            </div>
            <span class="hb-badge hb-badge--1">★ 4.9 · Google</span>
            <span class="hb-badge hb-badge--2">Live in 2–3 weeks</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hairline-gold mt-4 lg:mt-2 max-w-3xl mx-auto"></div>

    <div id="hero-stats" class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10 max-w-3xl mx-auto text-left" data-reveal>
      <div class="stat">
        <div class="stat-viz" aria-hidden="true">
          <svg viewBox="0 0 64 72" class="sw">
            <rect x="27" y="1" width="10" height="7" rx="2.5" class="sw-metal" />
            <rect x="30.5" y="7" width="3" height="4" class="sw-metal" />
            <rect x="48" y="9" width="7" height="4" rx="2" transform="rotate(38 51 11)" class="sw-metal" />
            <circle cx="32" cy="42" r="25" class="sw-face" />
            <circle cx="32" cy="42" r="25" class="sw-ring" />
            <circle cx="32" cy="42" r="25" class="sw-prog" />
            <line x1="32" y1="42" x2="32" y2="23" class="sw-hand" />
            <circle cx="32" cy="42" r="2.6" class="sw-pin" />
          </svg>
        </div>
        <div class="font-display text-3xl md:text-4xl lg:text-[2.7rem] gradient-cream leading-none">2–3<span class="italic-gold"> weeks</span></div>
        <div class="stat-label">Live launch · most studios ~8 wks</div>
      </div>
      <div class="stat">
        <div class="stat-viz" aria-hidden="true">
          <svg viewBox="0 0 64 72" class="gauge">
            <path d="M10 50 A24 24 0 1 1 54 50" class="g-track" />
            <path d="M10 50 A24 24 0 1 1 54 50" class="g-fill" />
            <line x1="32" y1="42" x2="20" y2="30" class="g-needle" />
            <circle cx="32" cy="42" r="3" class="sw-pin" />
          </svg>
        </div>
        <div class="font-display text-3xl md:text-4xl lg:text-[2.7rem] gradient-cream leading-none"><span class="num-count" data-to="1.8" data-dec="1">0.0</span><span class="italic-gold">s</span></div>
        <div class="stat-label">Page load · under 2 seconds</div>
      </div>
      <div class="stat">
        <div class="stat-viz" aria-hidden="true">
          <svg viewBox="0 0 64 72" class="tag">
            <path d="M8 30 L34 30 L56 52 L34 64 L34 64 L12 42 Z" class="tag-body" />
            <circle cx="18" cy="40" r="4" class="tag-hole" />
            <path d="M40 44 l8 8" class="tag-line" />
          </svg>
        </div>
        <div class="font-display text-3xl md:text-4xl lg:text-[2.7rem] gradient-cream leading-none">One fixed<span class="italic-gold"> price</span></div>
        <div class="stat-label">Agreed up front · no surprise bills</div>
      </div>
      <div class="stat">
        <div class="stat-viz" aria-hidden="true">
          <svg viewBox="0 0 64 72" class="lock">
            <path d="M22 34 V24 a10 10 0 0 1 19 -3" class="lk-shackle" />
            <rect x="16" y="34" width="32" height="26" rx="5" class="lk-body" />
            <circle cx="32" cy="45" r="3.2" class="sw-pin" />
            <rect x="30.6" y="46" width="2.8" height="7" rx="1.4" class="sw-pin" />
          </svg>
        </div>
        <div class="font-display text-3xl md:text-4xl lg:text-[2.7rem] gradient-cream leading-none">No annual<span class="italic-gold"> lock-in</span></div>
        <div class="stat-label">Month to month · cancel anytime</div>
      </div>
    </div>

    <div class="flex justify-center mt-16 hero-rise" style="--rise-delay: 640ms">
      <span class="scroll-cue" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var grid = document.getElementById("hero-stats");
    if (!grid) return;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function runCounts() {
      grid.querySelectorAll(".num-count").forEach(function (el) {
        var to = parseFloat(el.getAttribute("data-to")) || 0;
        var dec = parseInt(el.getAttribute("data-dec") || "0", 10);
        if (reduce) { el.textContent = to.toFixed(dec); return; }
        var start = null, dur = 1400;
        function tick(ts) {
          if (!start) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = (to * eased).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { grid.classList.add("stats-in"); runCounts(); io.disconnect(); }
        });
      }, { threshold: 0.4 });
      io.observe(grid);
    } else {
      grid.classList.add("stats-in"); runCounts();
    }
  })();
</script>
