---
const services = [
  {
    slug: "websites",
    index: "01",
    eyebrow: "Websites",
    title: "Sites built before people leave.",
    body:
      "Custom-built. Mobile-first. Wired to Google so the people nearby can actually find you. No bloated templates, no thirty-second loads — a clean shopfront that turns visits into bookings, calls and walk-ins.",
    bullets: ["Bespoke design", "Under two seconds", "Google-connected", "Care plan optional"],
    price: "From $1,800",
  },
  {
    slug: "social",
    index: "02",
    eyebrow: "Social",
    title: "Posts that fill the room.",
    body:
      "Planned, shot, written and scheduled — by the week or the month. You approve in ten minutes. The measure isn't follower count, it's a fuller Saturday.",
    bullets: ["Monthly content plan", "On-site photography", "Reels and stories", "Plain reporting"],
    price: "From $650/mo",
  },
  {
    slug: "catalogues",
    index: "03",
    eyebrow: "Catalogues",
    title: "Pieces worth keeping.",
    body:
      "Print and digital, designed together. A seasonal lookbook. A tasting card for a cellar door. A wholesale catalogue for a maker. Press-ready files and an interactive PDF — same project, same fee.",
    bullets: ["Press-ready artwork", "Interactive PDF", "Local print partner", "Reusable templates"],
    price: "From $850",
  },
];
---

<section id="services" class="relative text-cream">
  <div class="max-w-6xl mx-auto px-6 pt-28 pb-20 md:pt-40 md:pb-24 text-center">
    <div class="text-[12px] lg:text-[18px] font-medium uppercase tracking-[0.30em] text-gold mb-5">
      What we make
    </div>
    <h2 class="font-display display-tight text-5xl md:text-7xl lg:text-[5.4rem]">
      <span class="gradient-cream">Three things.</span>
      <br />
      <span class="italic-gold italic">Done with care.</span>
    </h2>
    <p class="mt-6 max-w-2xl mx-auto text-lg lg:text-[26px] text-cream-soft">
      The menu is short on purpose. Start with one — add the others when the time is right.
    </p>
  </div>

  <div class="relative">
    {
      services.map((s, i) => (
        <article class="stack-card" data-service={s.slug}>
          {/* Background illustration */}
          <div
            class="absolute inset-0 pointer-events-none"
            aria-hidden="true"
            style={`
              background-image: url('/illustrations/${s.slug}.svg');
              background-repeat: no-repeat;
              background-position: 104% center;
              background-size: auto 92%;
              opacity: 0.4;
              mix-blend-mode: lighten;
            `}
          />
          {/* Left-to-right fade */}
          <div
            class="absolute inset-0 pointer-events-none"
            aria-hidden="true"
            style="background: linear-gradient(95deg, rgba(8,8,11,0.6) 0%, rgba(8,8,11,0.28) 45%, rgba(8,8,11,0) 85%);"
          />

          <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-12 gap-10 w-full">
            <div class="md:col-span-5">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-display text-[64px] md:text-[88px] lg:text-[106px] leading-none gradient-crimson italic">
                  {s.index}
                </span>
                <div class="flex flex-col">
                  <span class="text-[11px] lg:text-[16px] uppercase tracking-[0.30em] text-gold">Service</span>
                  <span class="font-display text-lg lg:text-[26px] text-cream font-medium">{s.eyebrow}</span>
                </div>
              </div>
              <h3 class="font-display display-tight text-3xl md:text-5xl lg:text-[3.6rem] text-cream mt-6">
                {s.title}
              </h3>
              <div class="mt-8 inline-flex items-center gap-2 text-sm lg:text-[18px] font-medium px-4 py-2 rounded-full bg-graphite-soft/80 backdrop-blur border border-line-bright text-cream">
                {s.price}
              </div>
            </div>
            <div class="md:col-span-7 md:pt-2">
              <p class="text-lg md:text-xl lg:text-[28px] leading-relaxed text-cream-soft">
                {s.body}
              </p>
              <ul class="mt-10 grid grid-cols-2 gap-y-4 gap-x-6">
                {s.bullets.map((b) => (
                  <li class="flex items-center gap-3 text-[15px] lg:text-[20px] text-cream">
                    <span class="w-5 h-5 lg:w-7 lg:h-7 rounded-full flex items-center justify-center text-[10px] lg:text-[13px] font-bold shrink-0 bg-crimson-deep text-cream">
                      ✓
                    </span>
                    {b}
                  </li>
                ))}
              </ul>

              <div class="mt-10 flex items-center gap-4 text-[11px] lg:text-[16px] uppercase tracking-[0.28em] text-cream-mute">
                <span>0{i + 1}</span>
                <span class="flex-1 h-px bg-line-bright"></span>
                <span>0{services.length}</span>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
