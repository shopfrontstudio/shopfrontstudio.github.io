---
const services = [
  {
    eyebrow: "01 — Websites",
    title: "Sites that load before people leave.",
    body:
      "Custom-built. Mobile-first. Wired to Google so locals find you. No bloated templates, no 30-second load times — just a clean shopfront that converts visits into bookings, calls and walk-ins.",
    bullets: ["Custom design", "<2s on 4G", "Google-connected", "Care plan optional"],
    price: "From $1,800",
    theme: "light",
  },
  {
    eyebrow: "02 — Social media",
    title: "Posts that fill tables.",
    body:
      "We plan, shoot, write and schedule — weekly or monthly. You approve in ten minutes. The goal isn't follower count, it's a busier Saturday.",
    bullets: ["Monthly content plan", "On-site photography", "Reels + stories + posts", "Honest reporting"],
    price: "From $650/mo",
    theme: "dark",
  },
  {
    eyebrow: "03 — Catalogues",
    title: "Catalogues people keep.",
    body:
      "Print and digital, designed together. A seasonal lookbook for boutiques. A tasting card for wineries. A wholesale catalogue for makers. Press-ready files and an interactive PDF — same project, same fee.",
    bullets: ["Print-ready files", "Interactive PDF", "Local print partner", "Reusable templates"],
    price: "From $850",
    theme: "light",
  },
];
---

<section id="services" class="bg-white">
  <div class="max-w-6xl mx-auto px-6 pt-28 pb-10 md:pt-40 md:pb-16 text-center">
    <div class="text-[12px] font-medium uppercase tracking-[0.18em] text-accent mb-5">
      What we do
    </div>
    <h2 class="font-display display-tight text-5xl md:text-7xl font-bold">
      Three things.
      <br />
      <span class="text-ink/40">Done properly.</span>
    </h2>
    <p class="mt-6 max-w-2xl mx-auto text-lg text-ink-soft">
      We kept the menu short on purpose. Start with one, add the others when you're ready.
    </p>
  </div>

  <div class="space-y-0">
    {
      services.map((s) => {
        const isDark = s.theme === "dark";
        return (
          <article
            class:list={[
              "border-t",
              isDark ? "bg-black text-white border-black" : "bg-bg-alt text-ink border-line",
            ]}
          >
            <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 grid md:grid-cols-12 gap-10">
              <div class="md:col-span-5">
                <div
                  class:list={[
                    "text-[12px] font-medium uppercase tracking-[0.18em] mb-5",
                    isDark ? "text-accent" : "text-accent",
                  ]}
                >
                  {s.eyebrow}
                </div>
                <h3 class="font-display display-tight text-4xl md:text-6xl font-bold">
                  {s.title}
                </h3>
                <div
                  class:list={[
                    "mt-8 inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-full",
                    isDark ? "bg-white/10 text-white" : "bg-white text-ink border border-line",
                  ]}
                >
                  {s.price}
                </div>
              </div>
              <div class="md:col-span-7 md:pt-2">
                <p
                  class:list={[
                    "text-lg md:text-xl leading-relaxed",
                    isDark ? "text-white/75" : "text-ink-soft",
                  ]}
                >
                  {s.body}
                </p>
                <ul class="mt-10 grid grid-cols-2 gap-y-4 gap-x-6">
                  {s.bullets.map((b) => (
                    <li
                      class:list={[
                        "flex items-center gap-3 text-[15px]",
                        isDark ? "text-white/90" : "text-ink",
                      ]}
                    >
                      <span
                        class:list={[
                          "w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0",
                          isDark ? "bg-accent text-white" : "bg-accent text-white",
                        ]}
                      >
                        ✓
                      </span>
                      {b}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
