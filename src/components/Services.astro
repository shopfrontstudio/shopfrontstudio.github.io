---
import ServiceDevice from "./ServiceDevice.astro";

const services = [
  {
    slug: "websites",
    index: "01",
    eyebrow: "Websites",
    title: "Sites built before people leave.",
    body:
      "Custom-built. Mobile-first. Wired to Google so the people nearby can actually find you. No bloated templates, no thirty-second loads — a clean shopfront that turns visits into bookings, calls and walk-ins.",
    bullets: ["Bespoke design", "Under two seconds", "Google-connected", "Care plan optional"],
    price: "From $1,800",
  },
  {
    slug: "social",
    index: "02",
    eyebrow: "Social",
    title: "Posts that fill the room.",
    body:
      "Planned, shot, written and scheduled — by the week or the month. You approve in ten minutes. The measure isn't follower count, it's a fuller Saturday.",
    bullets: ["Monthly content plan", "On-site photography", "Reels and stories", "Plain reporting"],
    price: "From $1,200/mo",
  },
  {
    slug: "catalogues",
    index: "03",
    eyebrow: "Catalogues",
    title: "Pieces worth keeping.",
    body:
      "Print and digital, designed together. A seasonal lookbook. A tasting card for a cellar door. A wholesale catalogue for a maker. Press-ready files and an interactive PDF — same project, same fee.",
    bullets: ["Press-ready artwork", "Interactive PDF", "Local print partner", "Reusable templates"],
    price: "From $850",
  },
  {
    slug: "google",
    index: "04",
    eyebrow: "Google",
    title: "Found before they search your name.",
    body:
      "Your Google Business Profile, local search and reviews — set up and tended so the people nearby actually find you, on the map and in the results, not three pages down.",
    bullets: ["Profile optimised", "Local search", "Reviews handled", "Map presence"],
    price: "From $850/mo",
  },
];
---

<section id="services" class="relative text-cream">
  <div class="max-w-6xl mx-auto px-6 pt-28 pb-20 md:pt-40 md:pb-24 text-center">
    <div class="hairline-gold max-w-3xl mx-auto mb-20 md:mb-28 opacity-50"></div>
    <div class="text-[12px] lg:text-[18px] font-medium uppercase tracking-[0.30em] text-gold mb-5" data-reveal>
      What we make
    </div>
    <h2 class="font-display display-tight text-5xl md:text-7xl lg:text-[5.4rem]" data-reveal style="--reveal-delay: 80ms">
      <span class="gradient-cream">Three things.</span>
      <br />
      <span class="italic-gold italic">Done with care.</span>
    </h2>
    <p class="mt-6 max-w-2xl mx-auto text-lg lg:text-[26px] text-cream-soft" data-reveal style="--reveal-delay: 160ms">
      The menu is short on purpose. Start with one — add the others when the time is right.
    </p>
  </div>

  <div class="relative">
    {
      services.map((s, i) => (
        <article class="stack-card" data-service={s.slug}>
          {/* Left-to-right fade for depth */}
          <div class="card-fade absolute inset-0 pointer-events-none" aria-hidden="true"></div>
          {/* glass-clay sheen (light mode) */}
          <div class="card-sheen absolute inset-0 pointer-events-none" aria-hidden="true"></div>

          <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-12 gap-10 md:gap-12 items-center w-full">
            {/* text */}
            <div class={`md:col-span-7 ${i % 2 === 1 ? "md:order-2" : ""}`} data-reveal>
              <div class="flex items-center gap-3 mb-6">
                <span class="font-display text-[64px] md:text-[88px] lg:text-[106px] leading-none gradient-crimson italic">
                  {s.index}
                </span>
                <div class="flex flex-col">
                  <span class="text-[11px] lg:text-[16px] uppercase tracking-[0.30em] text-gold">Service</span>
                  <span class="font-display text-lg lg:text-[26px] text-cream font-medium">{s.eyebrow}</span>
                </div>
              </div>
              <h3 class="font-display display-tight text-3xl md:text-5xl lg:text-[3.6rem] text-cream">
                {s.title}
              </h3>
              <p class="mt-6 text-lg md:text-xl lg:text-[26px] leading-relaxed text-cream-soft max-w-xl">
                {s.body}
              </p>
              <ul class="mt-8 grid grid-cols-2 gap-y-4 gap-x-6 max-w-xl">
                {s.bullets.map((b) => (
                  <li class="flex items-center gap-3 text-[15px] lg:text-[19px] text-cream">
                    <span class="w-5 h-5 lg:w-7 lg:h-7 rounded-full flex items-center justify-center text-[10px] lg:text-[13px] font-bold shrink-0 bg-crimson-deep text-cream">
                      ✓
                    </span>
                    {b}
                  </li>
                ))}
              </ul>
              <div class="mt-8 flex items-center gap-5">
                <span class="inline-flex items-center gap-2 text-sm lg:text-[18px] font-medium px-4 py-2 rounded-full bg-graphite-soft border border-line-bright text-cream">
                  {s.price}
                </span>
                <span class="flex items-center gap-4 flex-1 text-[11px] lg:text-[15px] uppercase tracking-[0.28em] text-cream-mute">
                  <span>0{i + 1}</span>
                  <span class="flex-1 h-px bg-line-bright"></span>
                  <span>0{services.length}</span>
                </span>
              </div>
              <a
                href={`/${s.slug}`}
                class="group mt-7 inline-flex items-center gap-2 text-[15px] lg:text-[19px] font-medium text-cream border-b border-gold/50 pb-1 hover:border-gold transition-colors"
              >
                More about {s.eyebrow.toLowerCase()}
                <svg class="transition-transform group-hover:translate-x-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              </a>
            </div>

            {/* animated device */}
            <div class={`md:col-span-5 flex items-center justify-center ${i % 2 === 1 ? "md:order-1" : ""}`} data-reveal data-tilt style="--reveal-delay: 140ms">
              <ServiceDevice type={s.slug} />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script is:inline>
  (function () {
    var cards = document.querySelectorAll(".stack-card");
    if (!cards.length) return;

    function bumpLikes(card) {
      var el = card.querySelector(".like-count");
      if (!el || el.dataset.run) return;
      el.dataset.run = "1";
      var n = 1284;
      var t = setInterval(function () {
        n += Math.floor(Math.random() * 6) + 1;
        el.textContent = n.toLocaleString("en-US");
      }, 650);
      setTimeout(function () { clearInterval(t); }, 7000);
    }

    if (!("IntersectionObserver" in window)) {
      cards.forEach(function (c) { c.classList.add("in-view"); });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add("in-view"); bumpLikes(e.target); }
          else { e.target.classList.remove("in-view"); }
        });
      },
      { threshold: 0.3 }
    );
    cards.forEach(function (c) { io.observe(c); });
  })();
</script>
