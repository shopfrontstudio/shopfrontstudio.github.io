<div class="anara-anim relative w-full max-w-[min(19rem,40vh)] md:max-w-[min(22rem,44vh)] mx-auto">
  <svg
    viewBox="0 0 600 760"
    class="w-full h-auto block"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Anara pomegranate mark"
  >
    <defs>
      {crownLeaves.map((l) => (
        <linearGradient id={l.gid} gradientUnits="userSpaceOnUse" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}>
          <stop offset="0" stop-color={l.cbase} />
          <stop offset="1" stop-color={l.ctip} />
        </linearGradient>
      ))}

      {/* Per-dot matte finish: barely-there top light, colour, soft darker rim */}
      {dots.map((d, i) => (
        <radialGradient id={`dg${i}`} cx="0.5" cy="0.42" r="0.78">
          <stop offset="0" stop-color={lighten(d.fill, 0.07)} />
          <stop offset="0.55" stop-color={d.fill} />
          <stop offset="1" stop-color={darken(d.fill, 0.24)} />
        </radialGradient>
      ))}
    </defs>

    {/* Crown of five traced leaf petals */}
    <g data-leaves style="transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);">
      {crownLeaves.map((l) => <path d={l.d} fill={`url(#${l.gid})`} />)}
    </g>

    {/* Edges of the knowledge graph — populated by JS during cluster phases */}
    <g data-edges fill="none" stroke="rgba(206,167,103,0.55)" stroke-width="0.6" style="opacity: 0; transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1);"></g>

    {/* The dot field — the body of the fruit at rest, the swarm during motion */}
    <g data-dots>
      {dots.map((d, i) => (
        <circle
          cx={d.x} cy={d.y} r={d.r}
          fill={`url(#dg${i})`}
          data-hx={d.x} data-hy={d.y} data-hr={d.r}
        />
      ))}
    </g>

    {/* One-word service punch shown during cluster phases */}
    <text
      data-word
      x="300" y="706"
      text-anchor="middle"
      style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 64px; font-weight: 500; letter-spacing: -0.01em; fill: #f3ede0; opacity: 0; transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1);"
    >
      Discover.
    </text>
  </svg>
</div>

<script is:inline>
(function () {
  const wrap = document.querySelector(".anara-anim");
  if (!wrap) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const SVG_NS = "http://www.w3.org/2000/svg";
  const svg = wrap.querySelector("svg");
  const dotEls = Array.from(svg.querySelectorAll("[data-dots] circle"));
  const wordEl = svg.querySelector("[data-word]");
  const leavesEl = svg.querySelector("[data-leaves]");
  const edgesG = svg.querySelector("[data-edges]");

  // Centre the motion on the fruit's core.
  const CX = 300, CY = 412;

  // Spring-physics state per dot
  const dots = dotEls.map((el, i) => ({
    el, idx: i,
    hx: +el.dataset.hx, hy: +el.dataset.hy, hr: +el.dataset.hr,
    x: +el.dataset.hx, y: +el.dataset.hy, r: +el.dataset.hr,
    vx: 0, vy: 0,
    tx: +el.dataset.hx, ty: +el.dataset.hy, tr: +el.dataset.hr,
    seed: Math.random(),
    seed2: Math.random(),
    pulsePhase: Math.random() * Math.PI * 2,
    isAnchor: false,
  }));
  const N = dots.length;

  // Knowledge-graph skeleton: N anchor nodes on a polygon around the centre.
  let anchorPositions = [];

  function computeAnchors(n, rot) {
    const radius = 150;
    return Array.from({ length: n }, (_, i) => {
      const a = (i / n) * Math.PI * 2 + rot - Math.PI / 2; // first vertex at top
      return {
        x: CX + Math.cos(a) * radius,
        y: CY + Math.sin(a) * radius * 0.86,
      };
    });
  }

  const SVG_LINE = (a, b, op) => {
    const e = document.createElementNS(SVG_NS, "line");
    e.setAttribute("x1", a.x.toFixed(2)); e.setAttribute("y1", a.y.toFixed(2));
    e.setAttribute("x2", b.x.toFixed(2)); e.setAttribute("y2", b.y.toFixed(2));
    if (op) e.setAttribute("stroke-opacity", op);
    edgesG.appendChild(e);
  };

  // --- Target generators ---
  function setHome() {
    dots.forEach((d) => { d.tx = d.hx; d.ty = d.hy; d.tr = d.hr; d.isAnchor = false; });
    edgesG.style.opacity = "0";
  }

  function setScatter() {
    dots.forEach((d) => {
      const angle = d.seed * Math.PI * 2;
      const dist = 130 + d.seed2 * 200;
      d.tx = CX + Math.cos(angle) * dist;
      d.ty = CY + Math.sin(angle) * dist;
      d.tr = 2 + d.seed * 4;
      d.isAnchor = false;
    });
    edgesG.style.opacity = "0";
  }

  // Polygon cluster: n anchors with orbiting satellites + connecting edges.
  function setPolygonCluster(n, rot) {
    anchorPositions = computeAnchors(n, rot);
    const groupSize = Math.floor(N / n);

    dots.forEach((d, i) => {
      const anchorIdx = Math.min(Math.floor(i / groupSize), n - 1);
      const anchor = anchorPositions[anchorIdx];
      const isFirstInGroup = (i % groupSize) === 0;

      if (isFirstInGroup) {
        d.tx = anchor.x;
        d.ty = anchor.y;
        d.tr = 12 + d.seed * 3;
        d.isAnchor = true;
      } else {
        const orbitAngle = d.seed * Math.PI * 2 + rot * 0.6;
        const orbitR = 16 + d.seed2 * 32;
        d.tx = anchor.x + Math.cos(orbitAngle) * orbitR;
        d.ty = anchor.y + Math.sin(orbitAngle) * orbitR;
        d.tr = 1.8 + d.seed * 3;
        d.isAnchor = false;
      }
    });

    edgesG.innerHTML = "";
    for (let i = 0; i < n; i++) {
      SVG_LINE(anchorPositions[i], anchorPositions[(i + 1) % n]); // perimeter
      if (n >= 5) SVG_LINE(anchorPositions[i], anchorPositions[(i + 2) % n], "0.5"); // diagonals
    }
    edgesG.style.opacity = "1";
  }

  // Box cluster: 4 anchor nodes at rectangle corners, with both diagonals.
  // halfW === halfH gives a square; halfW > halfH gives a stretched rectangle.
  function setBoxCluster(halfW, halfH) {
    anchorPositions = [
      { x: CX - halfW, y: CY - halfH },
      { x: CX + halfW, y: CY - halfH },
      { x: CX + halfW, y: CY + halfH },
      { x: CX - halfW, y: CY + halfH },
    ];
    const groupSize = Math.floor(N / 4);
    dots.forEach((d, i) => {
      const ai = Math.min(Math.floor(i / groupSize), 3);
      const anchor = anchorPositions[ai];
      if ((i % groupSize) === 0) {
        d.tx = anchor.x; d.ty = anchor.y; d.tr = 12 + d.seed * 3; d.isAnchor = true;
      } else {
        const oa = d.seed * Math.PI * 2;
        const orr = 16 + d.seed2 * 30;
        d.tx = anchor.x + Math.cos(oa) * orr;
        d.ty = anchor.y + Math.sin(oa) * orr;
        d.tr = 1.8 + d.seed * 3; d.isAnchor = false;
      }
    });
    edgesG.innerHTML = "";
    for (let i = 0; i < 4; i++) SVG_LINE(anchorPositions[i], anchorPositions[(i + 1) % 4]);
    SVG_LINE(anchorPositions[0], anchorPositions[2], "0.5"); // diagonal
    SVG_LINE(anchorPositions[1], anchorPositions[3], "0.5"); // diagonal
    edgesG.style.opacity = "1";
  }

  // Seamless square -> rectangle -> line morph, driven every frame by progress p.
  // halfH shrinks to 0 (so the top/bottom corners merge into a blob at each end)
  // while halfW grows, and a thick rubber-band thread runs down the centre.
  const SQUARE_HALF = 92;
  const LINE_HALF = 255;
  function stretchTick(p) {
    const e = 1 - Math.pow(1 - p, 2.2); // ease-out: quick to ~3/4, then strains to tight
    const halfW = SQUARE_HALF + (LINE_HALF - SQUARE_HALF) * e;
    const halfH = SQUARE_HALF * (1 - e);
    const corners = [
      { x: CX - halfW, y: CY - halfH },
      { x: CX + halfW, y: CY - halfH },
      { x: CX + halfW, y: CY + halfH },
      { x: CX - halfW, y: CY + halfH },
    ];
    const groupSize = Math.floor(N / 4);
    dots.forEach((d, i) => {
      const ai = Math.min(Math.floor(i / groupSize), 3);
      const a = corners[ai];
      if ((i % groupSize) === 0) {
        d.tx = a.x; d.ty = a.y; d.tr = 12 + d.seed * 3; d.isAnchor = true;
      } else {
        const oa = d.seed * Math.PI * 2;
        const orr = (15 + d.seed2 * 28) * (1 - 0.55 * e);
        d.tx = a.x + Math.cos(oa) * orr;
        d.ty = a.y + Math.sin(oa) * orr * (1 - 0.65 * e); // orbits flatten toward the line
        d.tr = 1.8 + d.seed * 3; d.isAnchor = false;
      }
    });
    edgesG.innerHTML = "";
    const boxOp = ((1 - e) * 0.6).toFixed(2); // box edges fade out as it lines up
    for (let i = 0; i < 4; i++) SVG_LINE(corners[i], corners[(i + 1) % 4], boxOp);
    SVG_LINE(corners[0], corners[2], boxOp);
    SVG_LINE(corners[1], corners[3], boxOp);
    // Rubber band — a vibrating wavy string while slack, pulling tight as it stretches.
    // Amplitude peaks mid-stretch (loose string) and falls to 0 when taut (e -> 1).
    const amp = Math.sin(Math.PI * e) * 15;
    const osc = Math.cos(performance.now() * 0.0065);
    const segs = 30;
    const strands = [-3.2, 0, 3.2]; // three gold hairlines bowed apart in the middle
    for (const off of strands) {
      let bd = "";
      for (let s = 0; s <= segs; s++) {
        const u = s / segs;
        const x = (CX - halfW) + u * 2 * halfW;
        const env = Math.sin(Math.PI * u); // 0 at the blobs, 1 mid-span
        const y = CY + amp * Math.sin(3 * Math.PI * u) * osc + off * env;
        bd += (s === 0 ? "M " : "L ") + x.toFixed(1) + " " + y.toFixed(1) + " ";
      }
      const strand = document.createElementNS(SVG_NS, "path");
      strand.setAttribute("d", bd);
      strand.setAttribute("fill", "none");
      strand.setAttribute("stroke-width", (0.7 + e * 0.45).toFixed(2)); // hairline
      strand.setAttribute("stroke-opacity", (0.4 + e * 0.45).toFixed(2));
      strand.setAttribute("stroke-linecap", "round");
      edgesG.appendChild(strand);
    }
    edgesG.style.opacity = "1";
    if (e > 0.45) wordEl.textContent = "Unleash.";
  }

  // The two end-blobs slam together into one blob at the centre — same look as
  // on the string ends: a few thick cores with small satellites around them.
  function setMergeBlob() {
    dots.forEach((d, i) => {
      if (i % 22 === 0) {
        d.tx = CX + (d.seed - 0.5) * 12;
        d.ty = CY + (d.seed2 - 0.5) * 12;
        d.tr = 13 + d.seed * 4;
        d.isAnchor = true;
      } else {
        const oa = d.seed * Math.PI * 2;
        const orr = 7 + d.seed2 * 22;
        d.tx = CX + Math.cos(oa) * orr;
        d.ty = CY + Math.sin(oa) * orr;
        d.tr = 2 + d.seed * 3;
        d.isAnchor = false;
      }
    });
    edgesG.style.opacity = "0";
  }

  // Compress that blob into a dense, charged core (the nuclear squeeze).
  function setCorePoint() {
    dots.forEach((d) => {
      d.tx = CX + (d.seed - 0.5) * 3;
      d.ty = CY + (d.seed2 - 0.5) * 3;
      d.tr = 2.6;
      d.isAnchor = false;
    });
    edgesG.style.opacity = "0";
  }

  const setLeaves = (a) => { if (leavesEl) leavesEl.style.opacity = String(a); };

  // The cycle — logo, disperse, hexagon, square, seamless stretch to a string, snap, bloom.
  const sequence = [
    { name: "rest",     duration: 1750, action: setHome,                                  word: null,      leaves: 1.0 },
    { name: "disperse", duration: 700, action: setScatter,                               word: null,      leaves: 0.18 },
    { name: "found",    duration: 1540, action: () => setPolygonCluster(6, 0),            word: "Discover.", leaves: 0.10 },
    { name: "filled",   duration: 1190, action: () => setBoxCluster(SQUARE_HALF, SQUARE_HALF), word: "Craft.",    leaves: 0.10 },
    { name: "stretch",  duration: 1015, action: () => stretchTick(0), onTick: stretchTick, word: "Craft.",    leaves: 0.08 },
    { name: "slam",     duration: 300,  action: setMergeBlob, stiff: 0.085, damp: 0.80, word: "Unleash.", leaves: 0.06 },
    { name: "compress", duration: 310,  action: setCorePoint, stiff: 0.060, damp: 0.82, word: null, leaves: 0.04 },
    { name: "reform",   duration: 945, action: setHome,      stiff: 0.050, damp: 0.86, word: null, leaves: 1.0 },
  ];

  let idx = 0;
  let phaseStart = performance.now();

  function applyPhase(p) {
    p.action();
    if (p.word) {
      wordEl.textContent = p.word;
      wordEl.style.opacity = "1";
    } else {
      wordEl.style.opacity = "0";
    }
    setLeaves(p.leaves);
  }
  applyPhase(sequence[0]);

  const STIFFNESS = 0.036;
  const DAMPING = 0.82;

  let raf = 0;
  let running = false;
  const startTime = performance.now();

  function tick(now) {
    if (!running) return;
    if (now - phaseStart > sequence[idx].duration) {
      idx = (idx + 1) % sequence.length;
      phaseStart = now;
      applyPhase(sequence[idx]);
    }

    // Per-frame morphs (e.g. the seamless square -> rectangle -> line stretch).
    const ph = sequence[idx];
    if (ph.onTick) ph.onTick(Math.min(1, (now - phaseStart) / ph.duration));
    const stiff = ph.stiff ?? STIFFNESS; // phases can override the spring for slam/boom
    const damp = ph.damp ?? DAMPING;

    const isRest = sequence[idx].name === "rest";
    const t = (now - startTime) * 0.001;

    for (let i = 0; i < dots.length; i++) {
      const d = dots[i];

      let tx = d.tx, ty = d.ty;
      if (isRest) {
        tx += Math.sin(t * 1.2 + d.seed * 6) * 0.6;
        ty += Math.cos(t * 1.5 + d.seed2 * 5) * 0.5;
      }

      d.vx = (d.vx + (tx - d.x) * stiff) * damp;
      d.vy = (d.vy + (ty - d.y) * stiff) * damp;
      d.x += d.vx;
      d.y += d.vy;

      d.r += (d.tr - d.r) * 0.12;

      let displayR = d.r;
      if (d.isAnchor) {
        displayR = d.r * (1 + Math.sin(t * 3.2 + d.pulsePhase) * 0.14);
      }

      d.el.setAttribute("cx", d.x.toFixed(2));
      d.el.setAttribute("cy", d.y.toFixed(2));
      d.el.setAttribute("r", displayR.toFixed(2));
    }

    raf = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    running = true;
    phaseStart = performance.now();
    raf = requestAnimationFrame(tick);
  }
  function stop() {
    if (!running) return;
    running = false;
    cancelAnimationFrame(raf);
  }

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
    { threshold: 0.05 }
  );
  io.observe(wrap);
})();
</script>



