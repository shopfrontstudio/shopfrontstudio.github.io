---
// Resting-state dot positions — a radial halftone pomegranate.
// Dots sit in concentric rings: large + deep-maroon at the core, small +
// light-crimson at the rim. During animation JS moves each dot to a target;
// at rest the positions trace the fruit beneath a fanned crown of sepals.
const cx = 300, cy = 392;
const R = 238;             // body radius
const ringSpacing = 23;    // distance between rings (denser halftone)
const dotGap = 24;         // approx arc spacing between dots within a ring
const maxR = 12.5, minR = 4.2; // more even dot sizes across the disk

const lerp = (a, b, t) => a + (b - a) * t;
const hexToRgb = (h) => {
  const n = parseInt(h.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const rgbToHex = (r, g, b) =>
  "#" + [r, g, b].map((v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, "0")).join("");

// Radial colour ramp: deep maroon core -> light crimson rim.
const ramp = [
  { t: 0.0, c: "#5a0617" },
  { t: 0.45, c: "#9c142f" },
  { t: 0.72, c: "#c5304c" },
  { t: 0.9, c: "#dd5067" },
  { t: 1.0, c: "#ec7d8f" },
];
function colorAt(t) {
  t = Math.min(1, Math.max(0, t));
  for (let i = 0; i < ramp.length - 1; i++) {
    if (t <= ramp[i + 1].t) {
      const seg = (t - ramp[i].t) / (ramp[i + 1].t - ramp[i].t);
      const a = hexToRgb(ramp[i].c), b = hexToRgb(ramp[i + 1].c);
      return rgbToHex(lerp(a[0], b[0], seg), lerp(a[1], b[1], seg), lerp(a[2], b[2], seg));
    }
  }
  return ramp[ramp.length - 1].c;
}
// Deterministic 0..1 hash so the scatter looks organic but is stable per build.
const hash = (a, b) => {
  const v = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453;
  return v - Math.floor(v);
};

const dots = [];
// Core dot
dots.push({ x: cx, y: cy, r: maxR, fill: colorAt(0) });
const rings = Math.floor(R / ringSpacing);
for (let ring = 1; ring <= rings; ring++) {
  const radius = ring * ringSpacing;
  const count = Math.max(6, Math.round((2 * Math.PI * radius) / dotGap));
  const rot = ring * 0.4; // swirl each ring slightly
  for (let k = 0; k < count; k++) {
    const a = (k / count) * Math.PI * 2 + rot;
    const j = hash(ring, k);
    const rad = radius + (j - 0.5) * 6;
    const x = cx + Math.cos(a) * rad;
    const y = cy + Math.sin(a) * rad * 0.99; // a touch of squash
    const tNorm = radius / R; // 0 core .. 1 rim
    const vert = (cy - y) / R; // dots above centre read a shade lighter
    const tCol = tNorm - vert * 0.12 + (j - 0.5) * 0.06;
    const dotR = minR + (maxR - minR) * Math.pow(1 - tNorm, 0.55);
    const rr = Math.max(minR, dotR + (j - 0.5) * 2);
    dots.push({ x: +x.toFixed(2), y: +y.toFixed(2), r: +rr.toFixed(2), fill: colorAt(tCol) });
  }
}

// The crown — a single pointed-sepal template, fanned out by transforms.
const sepalPath = "M -20 0 C -14 -52 -6 -96 0 -130 C 6 -96 14 -52 20 0 Q 0 -10 -20 0 Z";
const sepals = [
  { rot: 0, s: 0.6, fill: "#7a0f24" },
  { rot: -20, s: 0.48, fill: "#8e1430" },
  { rot: 20, s: 0.48, fill: "#8e1430" },
  { rot: -40, s: 0.34, fill: "#a81a38" },
  { rot: 40, s: 0.34, fill: "#a81a38" },
];
const crownPivotX = 300, crownPivotY = 170;
---

<div class="anara-anim relative w-full max-w-[26rem] md:max-w-[30rem] lg:max-w-[34rem] mx-auto">
  <svg
    viewBox="0 0 600 760"
    class="w-full h-auto block drop-shadow-[0_30px_50px_rgba(185,29,58,0.30)]"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Anara pomegranate mark"
  >
    {/* The fanned crown of sepals */}
    <g data-leaves style="transition: opacity 800ms ease;">
      {
        sepals.map((sp) => (
          <path
            d={sepalPath}
            fill={sp.fill}
            transform={`translate(${crownPivotX} ${crownPivotY}) rotate(${sp.rot}) scale(${sp.s})`}
          />
        ))
      }
    </g>

    {/* Edges of the knowledge graph — populated by JS during cluster phases */}
    <g data-edges fill="none" stroke="rgba(243,237,224,0.32)" stroke-width="0.65" style="opacity: 0; transition: opacity 700ms ease;"></g>

    {/* The dot field — the body of the fruit at rest, the swarm during motion */}
    <g data-dots>
      {dots.map((d) => (
        <circle
          cx={d.x} cy={d.y} r={d.r}
          fill={d.fill}
          data-hx={d.x} data-hy={d.y} data-hr={d.r}
        />
      ))}
    </g>

    {/* One-word service punch shown during cluster phases */}
    <text
      data-word
      x="300" y="706"
      text-anchor="middle"
      style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 64px; font-weight: 500; letter-spacing: -0.01em; fill: #f3ede0; opacity: 0; transition: opacity 700ms ease;"
    >
      Found.
    </text>
  </svg>
</div>

<script is:inline>
(function () {
  const wrap = document.querySelector(".anara-anim");
  if (!wrap) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const SVG_NS = "http://www.w3.org/2000/svg";
  const svg = wrap.querySelector("svg");
  const dotEls = Array.from(svg.querySelectorAll("[data-dots] circle"));
  const wordEl = svg.querySelector("[data-word]");
  const leavesEl = svg.querySelector("[data-leaves]");
  const edgesG = svg.querySelector("[data-edges]");

  // Centre the motion on the fruit's core.
  const CX = 300, CY = 392;

  // Spring-physics state per dot
  const dots = dotEls.map((el, i) => ({
    el, idx: i,
    hx: +el.dataset.hx, hy: +el.dataset.hy, hr: +el.dataset.hr,
    x: +el.dataset.hx, y: +el.dataset.hy, r: +el.dataset.hr,
    vx: 0, vy: 0,
    tx: +el.dataset.hx, ty: +el.dataset.hy, tr: +el.dataset.hr,
    seed: Math.random(),
    seed2: Math.random(),
    pulsePhase: Math.random() * Math.PI * 2,
    isAnchor: false,
  }));
  const N = dots.length;

  // The knowledge-graph skeleton: 6 anchor nodes in a hexagon around the centre.
  const ANCHOR_COUNT = 6;
  let anchorPositions = [];

  function computeAnchors(phaseIndex) {
    const baseRot = phaseIndex * 0.18 * Math.PI * 2;
    const radius = 145;
    return Array.from({ length: ANCHOR_COUNT }, (_, i) => {
      const a = (i / ANCHOR_COUNT) * Math.PI * 2 + baseRot;
      return {
        x: CX + Math.cos(a) * radius,
        y: CY + Math.sin(a) * radius * 0.78,
      };
    });
  }

  // --- Target generators ---
  function setHome() {
    dots.forEach((d) => { d.tx = d.hx; d.ty = d.hy; d.tr = d.hr; d.isAnchor = false; });
    edgesG.style.opacity = "0";
  }

  function setScatter() {
    dots.forEach((d) => {
      const angle = d.seed * Math.PI * 2;
      const dist = 130 + d.seed2 * 200;
      d.tx = CX + Math.cos(angle) * dist;
      d.ty = CY + Math.sin(angle) * dist;
      d.tr = 2 + d.seed * 4;
      d.isAnchor = false;
    });
    edgesG.style.opacity = "0";
  }

  function setKnowledgeCluster(phaseIndex) {
    anchorPositions = computeAnchors(phaseIndex);
    const groupSize = Math.floor(N / ANCHOR_COUNT);

    dots.forEach((d, i) => {
      const anchorIdx = Math.min(Math.floor(i / groupSize), ANCHOR_COUNT - 1);
      const anchor = anchorPositions[anchorIdx];
      const isFirstInGroup = (i % groupSize) === 0;

      if (isFirstInGroup) {
        d.tx = anchor.x;
        d.ty = anchor.y;
        d.tr = 12 + d.seed * 3;
        d.isAnchor = true;
      } else {
        const orbitAngle = d.seed * Math.PI * 2 + phaseIndex * 0.6;
        const orbitR = 16 + d.seed2 * 32;
        d.tx = anchor.x + Math.cos(orbitAngle) * orbitR;
        d.ty = anchor.y + Math.sin(orbitAngle) * orbitR;
        d.tr = 1.8 + d.seed * 3;
        d.isAnchor = false;
      }
    });

    edgesG.innerHTML = "";
    for (let i = 0; i < anchorPositions.length; i++) {
      const a = anchorPositions[i];
      const next = anchorPositions[(i + 1) % anchorPositions.length];
      const e1 = document.createElementNS(SVG_NS, "line");
      e1.setAttribute("x1", a.x.toFixed(2));
      e1.setAttribute("y1", a.y.toFixed(2));
      e1.setAttribute("x2", next.x.toFixed(2));
      e1.setAttribute("y2", next.y.toFixed(2));
      edgesG.appendChild(e1);
      const diag = anchorPositions[(i + 2) % anchorPositions.length];
      const e2 = document.createElementNS(SVG_NS, "line");
      e2.setAttribute("x1", a.x.toFixed(2));
      e2.setAttribute("y1", a.y.toFixed(2));
      e2.setAttribute("x2", diag.x.toFixed(2));
      e2.setAttribute("y2", diag.y.toFixed(2));
      e2.setAttribute("stroke-opacity", "0.5");
      edgesG.appendChild(e2);
    }
    edgesG.style.opacity = "1";
  }

  const setLeaves = (a) => { if (leavesEl) leavesEl.style.opacity = String(a); };

  // The cycle — pomegranate at rest, disperse, three clusters, reform.
  const sequence = [
    { name: "rest",     duration: 3800, action: setHome,                       word: null,      leaves: 1.0 },
    { name: "disperse", duration: 1200, action: setScatter,                    word: null,      leaves: 0.18 },
    { name: "found",    duration: 2500, action: () => setKnowledgeCluster(0),  word: "Found.",  leaves: 0.10 },
    { name: "filled",   duration: 2500, action: () => setKnowledgeCluster(1),  word: "Filled.", leaves: 0.10 },
    { name: "kept",     duration: 2500, action: () => setKnowledgeCluster(2),  word: "Kept.",   leaves: 0.10 },
    { name: "reform",   duration: 1800, action: setHome,                       word: null,      leaves: 1.0 },
  ];

  let idx = 0;
  let phaseStart = performance.now();

  function applyPhase(p) {
    p.action();
    if (p.word) {
      wordEl.textContent = p.word;
      wordEl.style.opacity = "1";
    } else {
      wordEl.style.opacity = "0";
    }
    setLeaves(p.leaves);
  }
  applyPhase(sequence[0]);

  const STIFFNESS = 0.028;
  const DAMPING = 0.83;

  let raf = 0;
  let running = false;
  const startTime = performance.now();

  function tick(now) {
    if (!running) return;
    if (now - phaseStart > sequence[idx].duration) {
      idx = (idx + 1) % sequence.length;
      phaseStart = now;
      applyPhase(sequence[idx]);
    }

    const isRest = sequence[idx].name === "rest";
    const t = (now - startTime) * 0.001;

    for (let i = 0; i < dots.length; i++) {
      const d = dots[i];

      let tx = d.tx, ty = d.ty;
      if (isRest) {
        tx += Math.sin(t * 1.2 + d.seed * 6) * 0.6;
        ty += Math.cos(t * 1.5 + d.seed2 * 5) * 0.5;
      }

      d.vx = (d.vx + (tx - d.x) * STIFFNESS) * DAMPING;
      d.vy = (d.vy + (ty - d.y) * STIFFNESS) * DAMPING;
      d.x += d.vx;
      d.y += d.vy;

      d.r += (d.tr - d.r) * 0.09;

      let displayR = d.r;
      if (d.isAnchor) {
        displayR = d.r * (1 + Math.sin(t * 3.2 + d.pulsePhase) * 0.14);
      }

      d.el.setAttribute("cx", d.x.toFixed(2));
      d.el.setAttribute("cy", d.y.toFixed(2));
      d.el.setAttribute("r", displayR.toFixed(2));
    }

    raf = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    running = true;
    phaseStart = performance.now();
    raf = requestAnimationFrame(tick);
  }
  function stop() {
    if (!running) return;
    running = false;
    cancelAnimationFrame(raf);
  }

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
    { threshold: 0.05 }
  );
  io.observe(wrap);
})();
</script>
