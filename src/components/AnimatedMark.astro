// Glass look baked into each dot's fill as a radial gradient (cheap, no filter):
// a soft top-left highlight, the dot's colour, then a slightly darker rim.
const _rgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
const _hex = (r, g, b) => "#" + [r, g, b].map((v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, "0")).join("");
const lighten = (h, a) => { const [r, g, b] = _rgb(h); return _hex(r + (255 - r) * a, g + (255 - g) * a, b + (255 - b) * a); };
const darken = (h, a) => { const [r, g, b] = _rgb(h); return _hex(r * (1 - a), g * (1 - a), b * (1 - a)); };
