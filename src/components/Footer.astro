---
const year = new Date().getFullYear();
---

<footer class="border-t border-stone bg-cream mt-20">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col md:flex-row gap-6 justify-between text-sm text-ink/70">
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded bg-rust text-cream font-display font-bold flex items-center justify-center text-xs">S</span>
      <span class="font-display font-semibold text-ink">Shopfront Studio</span>
      <span class="ml-2">— Ballarat, Victoria</span>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="mailto:hello@shopfrontstudio.com.au" class="hover:text-rust">hello@shopfrontstudio.com.au</a>
      <a href="#contact" class="hover:text-rust">Get a quote</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>
