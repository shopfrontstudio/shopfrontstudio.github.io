---
const year = new Date().getFullYear();

const nav = [
  { href: "#services", label: "Services" },
  { href: "#how", label: "Process" },
  { href: "#about", label: "Studio" },
  { href: "#contact", label: "Contact" },
];

// TODO: replace these with the real Instagram / LinkedIn profile URLs.
const socials = [
  { label: "Instagram", href: "https://instagram.com/" },
  { label: "LinkedIn", href: "https://linkedin.com/" },
];
---

<footer class="relative bg-night/40 text-cream-mute border-t border-line/40 overflow-hidden">
  <div class="pom-rain" aria-hidden="true"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 pt-14 pb-24 md:pt-16 md:pb-28">
    <div class="grid gap-10 md:gap-8 md:grid-cols-12" data-reveal>
      {/* Brand + social */}
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <img src="/images/anara-mark.png" alt="" class="w-9 h-9 lg:w-11 lg:h-11 block" aria-hidden="true" />
          <span class="font-display font-medium text-cream tracking-[0.18em] text-lg lg:text-2xl">ANARA</span>
        </div>
        <p class="mt-4 text-[13px] lg:text-[16px] max-w-xs leading-relaxed">
          Marketing Solutions — websites, social and catalogues for businesses in and around Ballarat.
        </p>
        <div class="flex items-center gap-3 mt-6">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="w-10 h-10 inline-flex items-center justify-center rounded-full border border-line-bright text-cream-soft hover:text-cream hover:border-gold/60 transition-colors"
              >
                {s.label === "Instagram" ? (
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                ) : (
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zM8.5 8h3.83v2.05h.05c.53-1 1.84-2.05 3.78-2.05 4.04 0 4.79 2.66 4.79 6.11V23h-4v-6.4c0-1.53-.03-3.49-2.13-3.49-2.13 0-2.46 1.66-2.46 3.38V23h-4V8z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      {/* Navigate */}
      <div class="md:col-span-3">
        <div class="text-[11px] lg:text-[14px] font-medium uppercase tracking-[0.28em] text-gold mb-4">
          Navigate
        </div>
        <ul class="space-y-3 text-[14px] lg:text-[17px]">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-cream transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Contact */}
      <div class="md:col-span-4">
        <div class="text-[11px] lg:text-[14px] font-medium uppercase tracking-[0.28em] text-gold mb-4">
          Contact
        </div>
        <ul class="space-y-3 text-[14px] lg:text-[17px]">
          <li>
            <a href="mailto:info@anaramarketing.com.au" class="hover:text-cream transition-colors">
              info@anaramarketing.com.au
            </a>
          </li>
          <li>
            <a href="tel:+61473533053" class="hover:text-cream transition-colors">
              +61 473 533 053
            </a>
          </li>
          <li>Ballarat, Victoria</li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-12 pt-6 border-t border-line/40 flex flex-col sm:flex-row gap-3 justify-between text-[12px] lg:text-[15px]">
      <span>© {year} Anara Marketing Solutions</span>
      <span class="text-cream-mute">Made in Ballarat</span>
    </div>
  </div>

  <script>
    // Mini pomegranates rain from the top of the footer and settle into a
    // single covering layer along its base — triggered once when it scrolls in.
    const footer = document.querySelector("footer");
    const rain = footer && footer.querySelector(".pom-rain");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (footer && rain && !reduce) {
      let built = false;
      const build = () => {
        if (built) return;
        built = true;
        const W = footer.clientWidth;
        const H = footer.clientHeight;
        const base = W < 640 ? 28 : 40;
        const step = base * 0.8;
        const count = Math.min(96, Math.ceil(W / step) + 1);
        const reds = ["#c0233f", "#b51d39", "#cb2c4a"];
        const pomSVG = (body) => `<svg viewBox="0 0 64 64" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22 18 L25 7 L29 15 L32 4 L35 15 L39 7 L42 18 Z" fill="#7d1228"/>
          <path d="M32 14 C 47 14 54 27 54 39 C 54 52 45 61 32 61 C 19 61 10 52 10 39 C 10 27 17 14 32 14 Z" fill="${body}"/>
          <path d="M32 61 C 45 61 54 52 54 39 C 54 45 49 57 32 59 C 15 57 10 45 10 39 C 10 52 19 61 32 61 Z" fill="#7d1228" opacity="0.5"/>
          <ellipse cx="24.5" cy="30" rx="6" ry="8" fill="#ff7b8e" opacity="0.5"/>
        </svg>`;
        // shuffle the reveal order so they don't fall left-to-right
        const order = Array.from({ length: count }, (_, i) => i).sort(() => Math.random() - 0.5);
        order.forEach((i, rank) => {
          const size = base + (Math.random() * 8 - 4);
          const el = document.createElement("div");
          el.className = "pom";
          el.innerHTML = pomSVG(reds[(Math.random() * reds.length) | 0]);
          el.style.width = el.style.height = size.toFixed(1) + "px";
          el.style.left = (i * step - size * 0.12).toFixed(1) + "px";
          el.style.bottom = (Math.random() * 6).toFixed(1) + "px";
          rain.appendChild(el);
          const dx = Math.random() * 200 - 100;          // fall from varied directions
          const dy = -(H * (0.85 + Math.random() * 0.4)); // start near/above the top border
          const startRot = Math.random() * 120 - 60;
          const endRot = Math.random() * 22 - 11;
          el.animate(
            [
              { transform: `translate(${dx.toFixed(0)}px, ${dy.toFixed(0)}px) rotate(${startRot.toFixed(0)}deg) scale(0.5)`, opacity: 0, offset: 0 },
              { opacity: 1, offset: 0.22 },
              { transform: `translate(${(dx * 0.06).toFixed(0)}px, 7px) rotate(${(endRot * 1.4).toFixed(0)}deg) scale(1)`, opacity: 1, offset: 0.86 },
              { transform: `translate(0px,0px) rotate(${endRot.toFixed(0)}deg) scale(1)`, opacity: 1, offset: 1 },
            ],
            { duration: 900 + Math.random() * 500, delay: rank * 28 + Math.random() * 140, easing: "cubic-bezier(0.45,0,0.30,1)", fill: "both" }
          );
        });
      };
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) build(); }),
        { threshold: 0.25 }
      );
      io.observe(footer);
    }
  </script>
</footer>
