---
const year = new Date().getFullYear();
---

<footer class="bg-black text-white/60">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col md:flex-row gap-5 justify-between text-[13px]">
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-md bg-white text-black font-display font-bold flex items-center justify-center text-xs">S</span>
      <span class="font-display font-semibold text-white">Shopfront Studio</span>
      <span class="ml-2 text-white/40">— Ballarat, Victoria</span>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-white/50">
      <a href="mailto:hello@shopfrontstudio.com.au" class="hover:text-white transition-colors">hello@shopfrontstudio.com.au</a>
      <a href="#contact" class="hover:text-white transition-colors">Get a quote</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>
