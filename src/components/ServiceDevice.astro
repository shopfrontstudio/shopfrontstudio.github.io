---
// Animated skeuomorphic device mockups shown on each service slide.
// type: "websites" (laptop, page auto-scrolls) | "social" (phone, IG with
// likes/hearts) | "catalogues" (book, pages turning). Realistic fixed colours
// so they read in both light and dark themes. 2D transforms only (smooth, no lag).
const { type } = Astro.props;
---

{type === "websites" && (
  <svg class="dev dev-laptop" viewBox="0 0 360 300" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="lapAlu" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#dfe3e8" /><stop offset="0.5" stop-color="#b9bfc8" /><stop offset="1" stop-color="#969ca6" />
      </linearGradient>
      <linearGradient id="lapHero" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c02a4b" /><stop offset="1" stop-color="#7a0f24" />
      </linearGradient>
      <linearGradient id="lapGlass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.5" /><stop offset="0.4" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>
      <clipPath id="lapvp"><rect x="64" y="34" width="232" height="150" rx="3" /></clipPath>
    </defs>
    {/* lid */}
    <rect x="48" y="18" width="264" height="184" rx="12" fill="#1b1e24" stroke="url(#lapAlu)" stroke-width="3" />
    <circle cx="180" cy="26" r="1.6" fill="#41464e" />
    {/* scrolling page */}
    <g clip-path="url(#lapvp)">
      <rect x="64" y="34" width="232" height="150" fill="#fbfaf7" />
      <g class="lap-scroll">
        <rect x="64" y="34" width="232" height="14" fill="#ece7dd" />
        <circle cx="73" cy="41" r="2" fill="#e0726f" /><circle cx="81" cy="41" r="2" fill="#e3b35a" /><circle cx="89" cy="41" r="2" fill="#7bbf7e" />
        <rect x="100" y="37.5" width="120" height="7" rx="3.5" fill="#ffffff" />
        <rect x="64" y="48" width="232" height="52" fill="url(#lapHero)" />
        <text x="180" y="70" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="15" letter-spacing="3" fill="#f3ede0">ANARA</text>
        <rect x="150" y="78" width="60" height="4" rx="2" fill="#f3ede0" opacity="0.7" />
        <rect x="76" y="112" width="64" height="40" rx="4" fill="#efe9df" /><rect x="148" y="112" width="64" height="40" rx="4" fill="#efe9df" /><rect x="220" y="112" width="64" height="40" rx="4" fill="#efe9df" />
        <rect x="84" y="120" width="20" height="20" rx="4" fill="#c8a15a" opacity="0.7" /><rect x="156" y="120" width="20" height="20" rx="4" fill="#c02a4b" opacity="0.6" /><rect x="228" y="120" width="20" height="20" rx="4" fill="#c8a15a" opacity="0.7" />
        <rect x="76" y="166" width="150" height="6" rx="3" fill="#ddd5c6" /><rect x="76" y="178" width="200" height="6" rx="3" fill="#e7e0d2" /><rect x="76" y="190" width="170" height="6" rx="3" fill="#e7e0d2" />
        <rect x="76" y="206" width="208" height="62" rx="5" fill="url(#lapHero)" opacity="0.9" />
        <rect x="76" y="282" width="120" height="6" rx="3" fill="#ddd5c6" /><rect x="76" y="294" width="190" height="6" rx="3" fill="#e7e0d2" /><rect x="76" y="306" width="160" height="6" rx="3" fill="#e7e0d2" />
      </g>
    </g>
    <rect x="64" y="34" width="232" height="150" fill="url(#lapGlass)" opacity="0.12" />
    {/* base */}
    <path d="M30 202 L330 202 L352 228 L8 228 Z" fill="url(#lapAlu)" stroke="#8b9099" stroke-width="1" />
    <rect x="150" y="204" width="60" height="5" rx="2.5" fill="#9aa0a8" />
    <ellipse cx="180" cy="236" rx="176" ry="6" fill="#000000" opacity="0.12" />
  </svg>
)}

{type === "social" && (
  <svg class="dev dev-phone" viewBox="0 0 200 384" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="phEdge" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3a3f47" /><stop offset="0.5" stop-color="#15171c" /><stop offset="1" stop-color="#42474f" />
      </linearGradient>
      <linearGradient id="igPhoto" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e3b35a" /><stop offset="0.55" stop-color="#c02a4b" /><stop offset="1" stop-color="#7a0f24" />
      </linearGradient>
      <clipPath id="phvp"><rect x="42" y="16" width="116" height="352" rx="24" /></clipPath>
    </defs>
    <rect x="34" y="8" width="132" height="368" rx="30" fill="#15171c" stroke="url(#phEdge)" stroke-width="3" />
    <g clip-path="url(#phvp)">
      <rect x="42" y="16" width="116" height="352" fill="#fbfaf7" />
      {/* top bar */}
      <text x="52" y="36" font-family="Cormorant Garamond, Georgia, serif" font-size="14" font-style="italic" fill="#1d1d1f">Instagram</text>
      <path class="ig-toplike" d="M150 28 c-1.6 -2.4 -6 -1.6 -6 1.6 c0 2.4 6 5.4 6 5.4 c0 0 6 -3 6 -5.4 c0 -3.2 -4.4 -4 -6 -1.6 Z" fill="#c02a4b" />
      {/* stories */}
      <circle cx="54" cy="56" r="7" fill="none" stroke="#c8a15a" stroke-width="1.6" /><circle cx="74" cy="56" r="7" fill="none" stroke="#c02a4b" stroke-width="1.6" /><circle cx="94" cy="56" r="7" fill="none" stroke="#c8a15a" stroke-width="1.6" /><circle cx="114" cy="56" r="7" fill="none" stroke="#d8d2c6" stroke-width="1.6" />
      {/* post header */}
      <circle cx="54" cy="80" r="7" fill="url(#igPhoto)" /><rect x="66" y="76" width="44" height="5" rx="2.5" fill="#d8d2c6" /><rect x="66" y="84" width="30" height="4" rx="2" fill="#e7e0d2" />
      {/* photo */}
      <rect x="42" y="94" width="116" height="116" fill="url(#igPhoto)" />
      {/* actions */}
      <path class="ig-like" d="M58 226 c-2.2 -3.2 -8 -2.2 -8 2.2 c0 3.2 8 7.2 8 7.2 c0 0 8 -4 8 -7.2 c0 -4.4 -5.8 -5.4 -8 -2.2 Z" fill="#c02a4b" />
      <circle cx="84" cy="230" r="6.5" fill="none" stroke="#1d1d1f" stroke-width="1.6" />
      <path d="M104 224 l11 6 l-11 6 l3 -6 Z" fill="none" stroke="#1d1d1f" stroke-width="1.6" stroke-linejoin="round" />
      {/* likes + caption */}
      <text x="50" y="252" font-family="Montserrat, Arial, sans-serif" font-size="8" font-weight="700" fill="#1d1d1f"><tspan class="like-count">1,284</tspan> likes</text>
      <rect x="50" y="262" width="92" height="5" rx="2.5" fill="#d8d2c6" /><rect x="50" y="272" width="70" height="5" rx="2.5" fill="#e7e0d2" />
      <rect x="50" y="290" width="100" height="5" rx="2.5" fill="#ece6da" /><rect x="50" y="300" width="80" height="5" rx="2.5" fill="#ece6da" />
      {/* floating hearts + comment (base position on wrapper g, inner element animated) */}
      <g class="ig-floats">
        <g transform="translate(120 208)"><path class="fl-heart fl1" d="M0 3 c-2 -3 -7 -2 -7 2 c0 3.4 7 7 7 7 c0 0 7 -3.6 7 -7 c0 -4 -5 -5 -7 -2 Z" fill="#c02a4b" /></g>
        <g transform="translate(96 212)"><path class="fl-heart fl2" d="M0 3 c-2 -3 -7 -2 -7 2 c0 3.4 7 7 7 7 c0 0 7 -3.6 7 -7 c0 -4 -5 -5 -7 -2 Z" fill="#e0566f" /></g>
        <g transform="translate(138 214)"><path class="fl-heart fl3" d="M0 3 c-2 -3 -7 -2 -7 2 c0 3.4 7 7 7 7 c0 0 7 -3.6 7 -7 c0 -4 -5 -5 -7 -2 Z" fill="#c02a4b" /></g>
        <g transform="translate(58 198)"><g class="fl-cmt cm1"><rect x="0" y="0" width="66" height="18" rx="9" fill="#ffffff" stroke="#e7e0d2" /><rect x="9" y="6" width="30" height="3.5" rx="1.75" fill="#c8a15a" /><rect x="9" y="11" width="48" height="3.5" rx="1.75" fill="#ddd5c6" /></g></g>
      </g>
    </g>
    <rect x="84" y="14" width="32" height="9" rx="4.5" fill="#0a0a0c" />
    <ellipse cx="100" cy="378" rx="74" ry="5" fill="#000000" opacity="0.12" />
  </svg>
)}

{type === "catalogues" && (
  <svg class="dev dev-book" viewBox="0 0 340 264" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="bkCover" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a01731" /><stop offset="1" stop-color="#6a0f22" />
      </linearGradient>
      <linearGradient id="bkLeaf" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fbf7ee" /><stop offset="1" stop-color="#ece3d2" />
      </linearGradient>
    </defs>
    <ellipse cx="170" cy="240" rx="150" ry="12" fill="#000000" opacity="0.14" />
    {/* covers */}
    <rect x="20" y="38" width="300" height="192" rx="7" fill="url(#bkCover)" />
    <rect x="26" y="44" width="288" height="180" rx="4" fill="#560b1b" />
    {/* static pages under */}
    <rect x="30" y="48" width="138" height="172" fill="#efe7d6" />
    <rect x="172" y="48" width="138" height="172" fill="#f3ece0" />
    {/* content on right static page */}
    <rect x="184" y="60" width="80" height="44" rx="3" fill="#c02a4b" opacity="0.18" />
    <rect x="184" y="112" width="114" height="5" rx="2.5" fill="#d7cdb9" /><rect x="184" y="122" width="96" height="5" rx="2.5" fill="#e3dac8" /><rect x="184" y="132" width="108" height="5" rx="2.5" fill="#e3dac8" />
    <rect x="184" y="150" width="50" height="34" rx="3" fill="#c8a15a" opacity="0.3" /><rect x="244" y="150" width="54" height="34" rx="3" fill="#c02a4b" opacity="0.16" />
    {/* spine */}
    <rect x="168" y="38" width="4" height="192" fill="#4a0a16" />
    {/* flipping leaves (right half, hinge at spine x=170) */}
    <g class="bk-leaf lf1"><rect x="170" y="48" width="140" height="172" fill="url(#bkLeaf)" /><rect x="182" y="60" width="78" height="40" rx="3" fill="#c8a15a" opacity="0.25" /><rect x="182" y="108" width="110" height="5" rx="2.5" fill="#dcd2bf" /><rect x="182" y="118" width="92" height="5" rx="2.5" fill="#e6ddca" /><rect x="182" y="140" width="116" height="5" rx="2.5" fill="#e6ddca" /></g>
    <g class="bk-leaf lf2"><rect x="170" y="48" width="140" height="172" fill="url(#bkLeaf)" /><rect x="182" y="60" width="116" height="5" rx="2.5" fill="#dcd2bf" /><rect x="182" y="72" width="96" height="5" rx="2.5" fill="#e6ddca" /><rect x="182" y="92" width="70" height="48" rx="3" fill="#c02a4b" opacity="0.16" /><rect x="262" y="92" width="36" height="48" rx="3" fill="#c8a15a" opacity="0.22" /></g>
    <g class="bk-leaf lf3"><rect x="170" y="48" width="140" height="172" fill="url(#bkLeaf)" /><rect x="182" y="60" width="80" height="44" rx="3" fill="#c8a15a" opacity="0.22" /><rect x="182" y="112" width="112" height="5" rx="2.5" fill="#dcd2bf" /><rect x="182" y="122" width="92" height="5" rx="2.5" fill="#e6ddca" /></g>
    {/* page edge stack on the right */}
    <rect x="308" y="50" width="4" height="168" fill="#d8cdb6" />
  </svg>
)}
