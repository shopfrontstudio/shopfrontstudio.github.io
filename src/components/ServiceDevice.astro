---
// Animated device mockups per service slide, built in HTML/CSS so overflow
// clips reliably and the catalogue turns in real 3D.
// type: "websites" (MacBook) | "social" (iPhone) | "catalogues" (lookbook)
const { type } = Astro.props;
---

{type === "websites" && (
  <div class="dev dev-laptop" aria-hidden="true">
    <div class="dev-inner">
    <div class="lap-lid">
      <div class="lap-screen">
        <span class="lap-cam"></span>
        <div class="lap-vp">
          <div class="lap-page">
            <div class="lp-nav"><span class="lp-logo">ANARA</span><span class="lp-menu"><i></i><i></i><i></i></span></div>
            <div class="lp-hero"><div class="lp-h1">Your shopfront,</div><div class="lp-h2">considered online.</div><span class="lp-btn"></span></div>
            <div class="lp-cards"><div></div><div></div><div></div></div>
            <div class="lp-feat"><span class="lp-fimg"></span><span class="lp-flines"><i></i><i></i><i></i></span></div>
            <div class="lp-cards"><div></div><div></div><div></div></div>
            <div class="lp-foot"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="lap-deck"></div>
    </div>
  </div>
)}

{type === "social" && (
  <div class="dev dev-phone" aria-hidden="true">
    <div class="dev-inner">
    <div class="ph-frame">
      <span class="ph-island"></span>
      <div class="ph-screen">
        <div class="ph-status"><span>9:41</span><span class="ph-bars"></span></div>
        <div class="ig-top"><span class="ig-logo">Instagram</span><span class="ig-ti"></span></div>
        <div class="ig-stories"><i></i><i></i><i></i><i></i></div>
        <div class="ig-phead"><span class="ig-av"></span><span class="ig-name"></span></div>
        <div class="ig-photo"></div>
        <div class="ig-acts"><span class="ig-heart">♥</span><span class="ig-o"></span><span class="ig-s"></span></div>
        <div class="ig-likes"><b class="like-count">1,284</b> likes</div>
        <div class="ig-cap"><i></i><i></i></div>
        <div class="ig-fx">
          <span class="heart h1">♥</span><span class="heart h2">♥</span><span class="heart h3">♥</span>
          <span class="ig-cmt"><i></i><i></i></span>
        </div>
      </div>
    </div>
    </div>
  </div>
)}

{type === "catalogues" && (
  <div class="dev dev-book" aria-hidden="true">
    <div class="dev-inner">
    <div class="book">
      <div class="bk-page bk-l">
        <span class="pimg p2" style="height:96px"></span>
        <div class="ptitle">Spring Lookbook</div>
        <div class="psub">VOLUME 01 · 2026</div>
        <i class="pline"></i><i class="pline sh"></i>
      </div>
      <div class="bk-r">
        <div class="bk-page bk-rbase">
          <div class="ptitle sm">New Season</div>
          <div class="pgrid"><span class="pimg p3"></span><span class="pimg p4"></span><span class="pimg p1"></span><span class="pimg p2"></span></div>
        </div>
        <div class="leaf lf3">
          <div class="pg pf"><span class="pimg p3"></span><div class="ptitle sm">Behind the Make</div><i class="pline"></i><i class="pline sh"></i></div>
          <div class="pg pb"><div class="ptitle sm">Featured</div><div class="pgrid"><span class="pimg p4"></span><span class="pimg p2"></span></div><i class="pline sh"></i></div>
        </div>
        <div class="leaf lf2">
          <div class="pg pf"><div class="ptitle sm">The Essentials</div><span class="pimg wide p1"></span><i class="pline"></i><div class="pprice">from $35</div></div>
          <div class="pg pb"><span class="pimg p3"></span><i class="pline"></i><i class="pline sh"></i></div>
        </div>
        <div class="leaf lf1">
          <div class="pg pf"><span class="pimg wide p2"></span><div class="ptitle sm">The Edit</div><i class="pline"></i></div>
          <div class="pg pb"><div class="pgrid"><span class="pimg p1"></span><span class="pimg p4"></span></div><i class="pline"></i></div>
        </div>
      </div>
    </div>
    </div>
  </div>
)}

{type === "google" && (
  <div class="dev dev-search" aria-hidden="true">
    <div class="dev-inner">
      <div class="gs">
        <div class="gs-bar"><span class="gs-q"></span><span class="gs-dot"></span></div>
        <div class="gs-card">
          <span class="gs-thumb"></span>
          <div class="gs-info">
            <b>Anara Marketing</b>
            <div class="gs-stars"><span class="gs-fill"></span>★★★★★ <i>4.9 (48)</i></div>
            <div class="gs-meta">Marketing studio · Victoria AU</div>
            <div class="gs-tags"><u>Website</u><u>Open now</u><u>Directions</u></div>
          </div>
        </div>
        <div class="gs-map">
          <span class="gs-road r1"></span><span class="gs-road r2"></span><span class="gs-road r3"></span>
          <span class="gs-pin"><span class="gs-ping"></span></span>
        </div>
      </div>
    </div>
  </div>
)}
