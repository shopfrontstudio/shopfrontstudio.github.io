---
const steps = [
  {
    n: "01",
    label: "Coffee",
    title: "A coffee, no obligation.",
    body: "We meet at your shop or a café in town. Look at what you have. If we're not the right fit, we'll say so.",
  },
  {
    n: "02",
    label: "Proposal",
    title: "A one-page proposal.",
    body: "What we'll do, what it costs, when it's done. No surprise invoices. No twelve-month contracts.",
  },
  {
    n: "03",
    label: "Build",
    title: "Built in weeks.",
    body: "Websites go live in two or three weeks. Social starts within a week. Catalogues turn around in ten working days.",
  },
  {
    n: "04",
    label: "Support",
    title: "We stay in touch.",
    body: "Optional monthly care. Training so you can update things yourself. A real person to call when something breaks.",
  },
];
---

<section id="how" class="relative text-cream py-28 md:py-40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="hairline-gold max-w-3xl mx-auto mb-20 md:mb-28 opacity-50"></div>
    <div class="grid md:grid-cols-12 gap-14 md:gap-16">
      {/* sticky heading */}
      <div class="md:col-span-5">
        <div class="proc-sticky" data-reveal>
          <div class="text-[12px] lg:text-[18px] font-medium uppercase tracking-[0.30em] text-gold mb-5">
            The process
          </div>
          <h2 class="font-display display-tight text-5xl md:text-6xl lg:text-[4.6rem]">
            <span class="gradient-cream">Four steps,</span>
            <br />
            <span class="italic-gold italic">plainly stated.</span>
          </h2>
          <p class="mt-6 text-cream-soft text-[17px] lg:text-[22px] max-w-sm leading-relaxed">
            No jargon, no runaround. Here's exactly how working together goes.
          </p>
        </div>
      </div>

      {/* animated steps */}
      <div class="md:col-span-7 relative" data-proc>
        <div class="proc-line" data-proc-line aria-hidden="true"></div>
        <ol class="space-y-12 md:space-y-16">
          {
            steps.map((s, i) => (
              <li class="proc-step" data-proc-step data-reveal style={`--reveal-delay: ${i * 80}ms`}>
                <span class="proc-dot" aria-hidden="true"></span>
                <div class="flex items-baseline gap-4 mb-2">
                  <span class="font-display italic text-2xl lg:text-3xl text-gold leading-none">{s.n}</span>
                  <span class="text-[11px] lg:text-[14px] uppercase tracking-[0.28em] text-cream-mute">{s.label}</span>
                </div>
                <h3 class="font-display text-2xl md:text-3xl lg:text-[2.4rem] text-cream display-tight">
                  {s.title}
                </h3>
                <p class="mt-3 text-cream-soft leading-relaxed text-[17px] lg:text-[22px] max-w-md">
                  {s.body}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var wrap = document.querySelector("[data-proc]");
    if (!wrap) return;
    var line = wrap.querySelector("[data-proc-line]");
    var steps = wrap.querySelectorAll("[data-proc-step]");
    if (!("IntersectionObserver" in window)) {
      steps.forEach(function (s) { s.classList.add("is-active"); });
      if (line) line.classList.add("is-drawn");
      return;
    }
    var lineIO = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting && line) { line.classList.add("is-drawn"); lineIO.disconnect(); } });
    }, { threshold: 0.15 });
    lineIO.observe(wrap);

    var stepIO = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) e.target.classList.add("is-active"); });
    }, { threshold: 0.6, rootMargin: "0px 0px -10% 0px" });
    steps.forEach(function (s) { stepIO.observe(s); });
  })();
</script>
