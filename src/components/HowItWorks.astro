---
const steps = [
  {
    n: "01",
    title: "A coffee, no obligation.",
    body: "We meet at your shop or a café in town. Look at what you've got. If we're not the right fit, we'll say so.",
  },
  {
    n: "02",
    title: "A one-page proposal.",
    body: "What we'll do, what it costs, when it's done. No surprise invoices. No twelve-month contracts.",
  },
  {
    n: "03",
    title: "Built in weeks.",
    body: "Websites go live in 2–3 weeks. Social starts within a week. Catalogues turn around in 10 working days.",
  },
  {
    n: "04",
    title: "We stay in touch.",
    body: "Optional monthly care. Training so you can update things yourself. A real person to call when something breaks.",
  },
];
---

<section id="how" class="relative text-silver-100 py-28 md:py-40 border-t border-line/40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="text-[12px] font-medium uppercase tracking-[0.22em] text-silver-400 mb-5">
        How it works
      </div>
      <h2 class="font-display display-tight text-5xl md:text-7xl">
        <span class="text-white">Four steps.</span>
        <br />
        <span class="silver-text-soft">No jargon.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12 md:gap-x-16 md:gap-y-16">
      {
        steps.map((s) => (
          <div class="group">
            <div class="font-display text-[80px] md:text-[120px] font-bold leading-none silver-text-soft opacity-50 group-hover:opacity-100 group-hover:silver-text transition-all">
              {s.n}
            </div>
            <h3 class="font-display display-tight text-2xl md:text-3xl text-white mt-4">
              {s.title}
            </h3>
            <p class="mt-3 text-silver-300 leading-relaxed text-lg max-w-md">
              {s.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
