    <script is:inline>
      // Gate motion (reveal/intro) so content hides only when JS+motion are on.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-motion");
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@400;500;600;700&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="/images/anara-logo.jpg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="intro-veil" aria-hidden="true"></div>
    <Header />
    <main class="flex-1 relative">
      <div class="page-bg-photo" aria-hidden="true"></div>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from "lenis";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // 2 + 3 — reveal-on-scroll
      const revealEls = document.querySelectorAll("[data-reveal]");
      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-in"));
      }

      // 1 — smooth inertia scroll (desktop/wheel; native touch on mobile)
      if (!reduce) {
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
