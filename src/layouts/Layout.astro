---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Anara Marketing Solutions — Websites, social and catalogues for Australian small businesses",
  description = "Anara Marketing is a Victoria-based boutique studio creating websites, social content, catalogues and Google-connected digital presence for small businesses across Australia.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <script is:inline>
      // Set the theme before paint (no flash). Default = visitor's device setting.
      (function () {
        try {
          var t =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <meta name="theme-color" content="#0a0608" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Gate motion (reveal/intro) so content hides only when JS+motion are on.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-motion");
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="/images/anara-logo.jpg" />
    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Anara Marketing Solutions",
        description:
          "A Victoria-based boutique studio building websites, social content, catalogues and Google-connected digital presence for small businesses across Australia.",
        url: "https://anaramarketing.com.au",
        email: "info@anaramarketing.com.au",
        telephone: "+61473533053",
        image: "https://anaramarketing.com.au/apple-touch-icon.png",
        areaServed: "Australia",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Ballarat",
          addressRegion: "VIC",
          addressCountry: "AU",
        },
      })}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="intro-veil" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true"></div>
    <Header />
    <main class="flex-1 relative">
      <div class="page-bg-photo" aria-hidden="true"></div>
      {/* Framer-style ambient layer — soft colour orbs + frosted glass-clay
          tiles that drift slowly. Mainly for light mode's open space. */}
      <div class="ambient" aria-hidden="true">
        <span class="orb orb--gold"></span>
        <span class="orb orb--berry"></span>
        <span class="orb orb--blush"></span>
        <span class="glass-tile glass-tile--1"></span>
        <span class="glass-tile glass-tile--2"></span>
        <span class="glass-tile glass-tile--3"></span>
      </div>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from "lenis";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ── Theme toggle: the hanging pendant lamp ──────────────────────────
      // A tap flips the theme. You can also grab & flick the lamp — the harder
      // / faster the flick, the more vigorously it swings (a tiny spring-
      // pendulum simulation seeded by your pointer velocity).
      const lamp = document.getElementById("theme-toggle");
      const hang = lamp?.querySelector(".lamp__hang") as HTMLElement | null;

      const flipTheme = () => {
        const next =
          document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", next === "light" ? "#f4efe4" : "#0a0608");
      };

      if (lamp && hang) {
        try {
          const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

        // pendulum state (degrees, deg/s)
        const SPRING = 85;   // stiffness → swing speed
        const DAMP = 4.0;    // how quickly it settles
        const MAXA = 34;     // clamp extreme angles
        let angle = 0, vel = 0, raf = 0, last = 0;

        let dragging = false, startX = 0, startT = 0, lastX = 0, lastT = 0, vX = 0, moved = 0;

        const startLoop = () => {
          if (raf || reduce) return;
          hang.classList.add("lamp--free"); // suspend the idle CSS sway
          last = performance.now();
          raf = requestAnimationFrame(step);
        };
        const step = (now: number) => {
          let dt = (now - last) / 1000;
          last = now;
          if (dt > 0.05) dt = 0.05;
          if (!dragging) {
            const acc = -SPRING * angle - DAMP * vel; // spring toward rest + damping
            vel += acc * dt;
            angle += vel * dt;
            if (angle > MAXA) { angle = MAXA; vel *= -0.25; }
            if (angle < -MAXA) { angle = -MAXA; vel *= -0.25; }
          }
          hang.style.transform = "rotate(" + angle.toFixed(3) + "deg)";
          if (!dragging && Math.abs(angle) < 0.05 && Math.abs(vel) < 0.6) {
            hang.style.transform = "";
            hang.classList.remove("lamp--free"); // hand back to the idle sway
            cancelAnimationFrame(raf); raf = 0;
            return;
          }
          raf = requestAnimationFrame(step);
        };

        lamp.addEventListener("pointerdown", (e) => {
          if (reduce) return;
          dragging = true; moved = 0; vX = 0;
          startX = lastX = e.clientX; startT = lastT = performance.now();
          lamp.setPointerCapture?.(e.pointerId);
          startLoop();
        });
        lamp.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          const now = performance.now();
          const dx = e.clientX - lastX;
          vX = (dx / Math.max(now - lastT, 1)) * 1000; // px/s
          lastX = e.clientX; lastT = now;
          moved += Math.abs(dx);
          angle = clamp((e.clientX - startX) * 0.18, -MAXA, MAXA); // follow the finger
          vel = 0;
        });
        const release = () => {
          if (!dragging) return;
          dragging = false;
          const dur = performance.now() - startT;
          if (moved < 10 && dur < 350) {
            flipTheme();                        // a tap toggles the theme…
            vel = (Math.random() < 0.5 ? -1 : 1) * 130; // …with a gentle knock
          } else {
            vel = clamp(vX * 0.22, -900, 900);  // a flick: speed → swing force
          }
          startLoop();
        };
        lamp.addEventListener("pointerup", release);
        lamp.addEventListener("pointercancel", release);
        lamp.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            flipTheme();
            if (!reduce) { vel = 160; startLoop(); }
          }
        });
        } catch (err) {
          /* never let the lamp break the rest of the page scripts */
        }
      }

      // 1 — smooth inertia scroll (desktop/wheel; native touch on mobile)
      let lenis = null;
      if (!reduce) {
        lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      const isDesktop = window.matchMedia("(min-width: 1024px) and (pointer: fine)").matches;

      // ── Scroll progress bar ─────────────────────────────────────────────
      const bar = document.querySelector(".scroll-progress") as HTMLElement | null;
      if (bar) {
        let ticking = false;
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? h.scrollTop / max : 0;
          bar.style.transform = "scaleX(" + p.toFixed(4) + ")";
          ticking = false;
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener("scroll", onScroll, { passive: true });
        update();
      }

      // ── Navbar: solid-glass state once scrolled ─────────────────────────
      const header = document.querySelector("header");
      if (header) {
        const onScrollHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
        window.addEventListener("scroll", onScrollHeader, { passive: true });
        onScrollHeader();
      }

      // ── Smooth anchor scrolling (routes through Lenis when active) ───────
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", (e) => {
          const id = a.getAttribute("href");
          if (!id || id === "#") return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          if (lenis) lenis.scrollTo(target, { offset: -64, duration: 1.2 });
          else target.scrollIntoView({ behavior: "smooth" });
        });
      });

      // ── Magnetic buttons (desktop, fine pointer) ────────────────────────
      if (isDesktop && !reduce) {
        document.querySelectorAll("[data-magnetic]").forEach((el) => {
          const strength = 0.3;
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const x = e.clientX - (r.left + r.width / 2);
            const y = e.clientY - (r.top + r.height / 2);
            el.style.transform = "translate(" + x * strength + "px," + y * strength + "px)";
          });
          el.addEventListener("pointerleave", () => { el.style.transform = ""; });
        });

        // ── Cursor-following glow, hero only ──────────────────────────────
        const glow = document.querySelector(".cursor-glow") as HTMLElement | null;
        const hero = document.querySelector("[data-hero]") as HTMLElement | null;
        if (glow && hero) {
          hero.addEventListener("pointermove", (e) => {
            glow.style.opacity = "1";
            glow.style.transform = "translate(" + (e.clientX - 250) + "px," + (e.clientY - 250) + "px)";
          });
          hero.addEventListener("pointerleave", () => { glow.style.opacity = "0"; });
        }

        // ── Subtle 3D tilt on service devices ─────────────────────────────
        document.querySelectorAll("[data-tilt]").forEach((card) => {
          const inner = card.querySelector(".dev-inner") as HTMLElement | null;
          if (!inner) return;
          card.addEventListener("pointermove", (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            inner.style.transform = "perspective(900px) rotateY(" + px * 8 + "deg) rotateX(" + -py * 8 + "deg)";
          });
          card.addEventListener("pointerleave", () => { inner.style.transform = ""; });
        });
      }
    </script>

    <!-- Reveal-on-scroll runs as a standalone inline (classic) script, NOT part
         of the bundled module above. This guarantees page sections are always
         un-hidden even if the module fails to load/parse on some browser — so a
         script error can never leave a blank page. Plain ES5 syntax on purpose. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var els = document.querySelectorAll("[data-reveal]");
        if (!reduce && "IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-in");
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
          );
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(function (el) { el.classList.add("is-in"); });
        }
        // Failsafe: if anything is still hidden a few seconds in, show it.
        setTimeout(function () {
          document.querySelectorAll("[data-reveal]:not(.is-in)").forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight) el.classList.add("is-in");
          });
        }, 3000);
      })();
    </script>
  </body>
</html>
