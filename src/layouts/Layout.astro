---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Anara Marketing Solutions — Websites, social and catalogues for Ballarat businesses",
  description = "A small studio in Ballarat. Considered websites, social media management, and print and digital catalogues for local businesses.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <script is:inline>
      // Set the theme before paint (no flash). Default = visitor's device setting.
      (function () {
        try {
          var t =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <meta name="theme-color" content="#0a0608" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Gate motion (reveal/intro) so content hides only when JS+motion are on.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-motion");
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@400;500;600;700&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="/images/anara-logo.jpg" />
    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Anara Marketing Solutions",
        description:
          "A small Ballarat studio building websites, running social media, and producing print and digital catalogues for local businesses.",
        url: "https://anaramarketing.com.au",
        email: "info@anaramarketing.com.au",
        telephone: "+61473533053",
        image: "https://anaramarketing.com.au/apple-touch-icon.png",
        areaServed: "Ballarat, Victoria, Australia",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Ballarat",
          addressRegion: "VIC",
          addressCountry: "AU",
        },
      })}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="intro-veil" aria-hidden="true"></div>
    <Header />
    <main class="flex-1 relative">
      <div class="page-bg-photo" aria-hidden="true"></div>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from "lenis";

      // Theme toggle — the hanging pendant lamp. Clicking flips the theme and
      // jolts the lamp so it swings as if knocked.
      const themeBtn = document.getElementById("theme-toggle");
      const lampHang = themeBtn?.querySelector(".lamp__hang");
      lampHang?.addEventListener("animationend", (e) => {
        if (e.animationName === "lamp-shake") lampHang.classList.remove("lamp--shaking");
      });
      themeBtn?.addEventListener("click", () => {
        const next =
          document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", next === "light" ? "#f4efe4" : "#0a0608");
        if (lampHang) {
          lampHang.classList.remove("lamp--shaking");
          void lampHang.offsetWidth; // reflow so the animation restarts
          lampHang.classList.add("lamp--shaking");
        }
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // 2 + 3 — reveal-on-scroll
      const revealEls = document.querySelectorAll("[data-reveal]");
      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-in"));
      }

      // 1 — smooth inertia scroll (desktop/wheel; native touch on mobile)
      if (!reduce) {
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
